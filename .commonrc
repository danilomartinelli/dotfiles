#!/usr/bin/env zsh

# =======================================
# NOTE: This file is for non-sensitive common environment variables
# that you want to share across different machines.
# Put sensitive data in ~/.localrc instead.
# =======================================

# Locale. No LC_ALL: it overrides every category and breaks script-visible
# collation and number formatting; LANG keeps the pt-BR interface.
export LANG="pt_BR.UTF-8"

# Default editor (override if needed). --wait keeps synchronous consumers
# (crontab -e, visudo, sops, kubectl edit) blocked until the buffer closes.
# Git resolves its editor via core.editor in gitconfig; no GIT_EDITOR here.
export EDITOR="zed --wait"
export VISUAL="zed --wait"

# Workspace + projects root used by `c` / completion (override in .localrc)
export WORKSPACE="${WORKSPACE:-$HOME/Workspace}"
export PROJECTS="${PROJECTS:-$WORKSPACE/github.com}"

# XDG base directories (keep tools predictable across machines).
# XDG_CONFIG_HOME is pinned rather than defaulted: topic installers link into
# ~/.config unconditionally, so a tool that does honour the variable must not
# be sent looking anywhere else.
# See docs/adr/0003-tool-config-directories-are-not-xdg-derived.md.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
# Stays overridable on purpose: run-once markers are ours to place, so
# _installer_state_dir honours this one where installer_config_dir does not.
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Homebrew (non-interactive / CI-friendly defaults)
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_BAT=1

# Man pages through bat for syntax highlighting (pairs with HOMEBREW_BAT).
if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# GPG / SSH helpers for interactive terminals
export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null)}"

# Android / React Native (paths are extended in android-studio/path.zsh)
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"

# Prefer OrbStack's Docker socket when present
if [[ -z "${DOCKER_HOST:-}" && -S "$HOME/.orbstack/run/docker.sock" ]]; then
  export DOCKER_HOST="unix://$HOME/.orbstack/run/docker.sock"
fi
