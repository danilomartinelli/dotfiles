<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.danilomartinelli.opencode-desktop-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>__DESKTOP_SERVER_SCRIPT__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__LOG_DIRECTORY__/desktop-server.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIRECTORY__/desktop-server.error.log</string>
</dict>
</plist>
