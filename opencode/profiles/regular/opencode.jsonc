{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "coder": {
      "model": "openai/gpt-5.6-luna",
      "temperature": 0.2,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "temperature": 0.2,
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "researcher": {
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.4,
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "scribe": {
      "model": "openai/gpt-5.6-luna",
      "temperature": 1,
      "reasoningEffort": "low",
      "textVerbosity": "high"
    },
    "reviewer": {
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.1,
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}