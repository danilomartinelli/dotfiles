{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "permission": {
    "linear_*": "allow"
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "coder": {
      "model": "openai/gpt-5.6-luna",
      "temperature": 0.2,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "temperature": 0.2,
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "researcher": {
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.4,
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permission": {
        "bash": {
          "glab repo view*": "allow",
          "glab mr view*": "allow",
          "glab mr list*": "allow",
          "glab issue view*": "allow",
          "glab issue list*": "allow",
          "glab release view*": "allow",
          "glab release list*": "allow",
          "glab ci get*": "allow",
          "glab ci list*": "allow",
          "glab ci status*": "allow",
          "glab ci trace*": "allow",
          "glab ci config view*": "allow",
          "glab search *": "allow",
          "glab api *": "allow"
        }
      }
    },
    "scribe": {
      "model": "openai/gpt-5.6-luna",
      "temperature": 1,
      "reasoningEffort": "low",
      "textVerbosity": "high"
    },
    "reviewer": {
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.1,
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    }
  }
}
