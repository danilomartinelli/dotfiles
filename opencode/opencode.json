{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "autoupdate": true,
  "lsp": true,
  "skills": {
    "paths": ["__DOTFILES_ROOT__/_shared/agents/skills"]
  },
  "instructions": ["__DOTFILES_ROOT__/_shared/agents/AGENTS.md"],
  "mcp": {
    "codegraph": {
      "enabled": true,
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ]
    }
  },
  "plugin": ["opencode-claude-auth@latest", "oh-my-opencode-slim"]
}
