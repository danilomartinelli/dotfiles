{
	"$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
	"enabled": true,
	"autoUpdate": false,
	"debug": false,
	"pruneNotification": "detailed",
	"pruneNotificationType": "chat",
	"commands": {
		"enabled": true,
		"protectedTools": [
			"delegate",
			"delegation_read",
			"delegation_list",
			"plan_save",
			"plan_read",
			"worktree_list",
			"worktree_inspect",
			"worktree_create",
			"worktree_delete"
		]
	},
	"manualMode": {
		"enabled": false,
		"automaticStrategies": true
	},
	"experimental": {
		"allowSubAgents": false,
		"customPrompts": false
	},
	"compress": {
		"mode": "range",
		"permission": "allow",
		"showCompression": false,
		"summaryBuffer": true,
		"maxContextLimit": 100000,
		"minContextLimit": 50000,
		"nudgeFrequency": 5,
		"iterationNudgeThreshold": 15,
		"nudgeForce": "soft",
		"protectedTools": [
			"delegate",
			"delegation_read",
			"delegation_list",
			"plan_save",
			"plan_read",
			"worktree_list",
			"worktree_inspect",
			"worktree_create",
			"worktree_delete"
		],
		"protectUserMessages": false
	},
	"strategies": {
		"deduplication": {
			"enabled": true,
			"protectedTools": [
				"delegate",
				"delegation_read",
				"delegation_list",
				"plan_save",
				"plan_read",
				"worktree_list",
				"worktree_inspect",
				"worktree_create",
				"worktree_delete"
			]
		},
		"purgeErrors": {
			"enabled": true,
			"turns": 4,
			"protectedTools": [
				"delegate",
				"delegation_read",
				"delegation_list",
				"plan_save",
				"plan_read",
				"worktree_list",
				"worktree_inspect",
				"worktree_create",
				"worktree_delete"
			]
		}
	}
}
