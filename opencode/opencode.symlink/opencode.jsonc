{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "lsp": true,
  "permission": {
    "task": "deny",
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "worktree_*": "deny",
  },
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "researcher": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "permission": {
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep_*": "allow",
        "kagi_*": "deny",
        "webfetch": "allow",
        "write": "deny",
        "edit": "deny",
        "plan_read": "deny",
        "todoread": "deny",
        "bash": {
          "*": "deny",
          "gh repo view*": "allow",
          "gh pr view*": "allow",
          "gh pr list*": "allow",
          "gh issue view*": "allow",
          "gh issue list*": "allow",
          "gh release view*": "allow",
          "gh release list*": "allow",
          "gh run view*": "allow",
          "gh run list*": "allow",
          "gh workflow list*": "allow",
          "gh search *": "allow",
          "gh api *": "allow",
          "glab repo view*": "allow",
          "glab repo list*": "allow",
          "glab mr view*": "allow",
          "glab mr list*": "allow",
          "glab issue view*": "allow",
          "glab issue list*": "allow",
          "glab release view*": "allow",
          "glab release list*": "allow",
          "glab ci get*": "allow",
          "glab ci list*": "allow",
          "glab ci status*": "allow",
          "glab ci view*": "allow",
          "glab ci config*": "allow",
          "glab repo search*": "allow",
          "glab search semantic*": "allow",
          "glab api *": "allow",
          "npm view*": "allow",
          "npm info*": "allow",
          "npm show*": "allow",
          "pip show*": "allow",
          "pip index*": "allow",
          "cargo search*": "allow",
          "cargo info*": "allow",
          "man *": "allow",
          "tldr *": "allow",
          "dig *": "allow",
          "nslookup *": "allow",
          "whois *": "allow",
          "host *": "allow",
          "jq *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "base64 *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "wc *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "awk *": "allow",
          "tr *": "allow",
        },
      },
    },
    "scribe": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "permission": {
        "codegraph_*": "allow",
        "bash": {
          "*": "deny",
        },
        "edit": "allow",
        "glob": "allow",
        "read": "allow",
        "write": "allow",
        "plan_read": "deny",
        "todoread": "deny",
      },
    },
    "coder": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high",
      "permission": {
        "codegraph_*": "allow",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "plan_read": "deny",
        "todoread": "deny",
      },
    },
    "reviewer": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "rg *": "allow",
        },
        "plan_read": "allow",
        "delegation_read": "allow",
        "delegation_list": "allow",
      },
    },
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
        },
        "task": "allow",
        "worktree_*": "allow",
        "worktree_delete": "deny",
      },
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "prompt": "You are a build orchestrator. Delegate implementation and verification to `coder`, documentation to `scribe`, codebase analysis to `explore`, and external research to `researcher`. You may inspect Git and perform final delivery only under the injected delivery policy. Do not edit files or run implementation and verification commands directly.",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch --show-current*": "allow",
          "git rev-parse*": "allow",
          "git symbolic-ref*": "allow",
          "git remote*": "allow",
          "git add*": "ask",
          "git commit*": "ask",
          "git fetch*": "ask",
          "git pull --ff-only*": "ask",
          "git push*": "ask",
          "gh pr create*": "ask",
          "gh pr view*": "allow",
          "gh pr status*": "allow",
          "glab mr create*": "ask",
          "glab mr view*": "allow",
          "git push --force*": "deny",
          "git push -f*": "deny",
        },
        "task": "allow",
        "worktree_*": "allow",
        "worktree_delete": "ask",
      },
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "plan_read": "deny",
        "todoread": "deny",
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "tree *": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git branch*": "allow",
          "git ls-files*": "allow",
          "uname*": "allow",
          "hostname": "allow",
          "whoami": "allow",
          "which *": "allow",
          "realpath *": "allow",
        },
      },
    },
  },
  "mcp": {
    "codegraph": {
      "enabled": true,
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },
  "instructions": ["{env:OPENCODE_CONFIG_DIR}/tools/philosophy.md"],
  "plugin": [
    "@rama_nigg/open-cursor@2.5.6",
    "opencode-claude-auth@latest",
    "@tarquinen/opencode-dcp@3.1.3",
    "@franlol/opencode-md-table-formatter@0.0.6",
  ],
  "provider": {
    "cursor-acp": {
      "name": "Cursor",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:32124/v1",
      },
      "models": {
        "auto": {
          "name": "Auto",
          "cost": {
            "input": 1.25,
            "output": 6,
            "cache_read": 0.25,
            "cache_write": 1.25,
          },
        },
        "composer-1.5": {
          "name": "Composer 1.5",
          "cost": {
            "input": 3.5,
            "output": 17.5,
            "cache_read": 0.35,
            "cache_write": 3.5,
          },
        },
        "composer-1": {
          "name": "Composer 1",
        },
        "opus-4.6-thinking": {
          "name": "Claude 4.6 Opus (Thinking)",
        },
        "opus-4.6": {
          "name": "Claude 4.6 Opus",
        },
        "sonnet-4.6": {
          "name": "Claude 4.6 Sonnet",
        },
        "sonnet-4.6-thinking": {
          "name": "Claude 4.6 Sonnet (Thinking)",
        },
        "opus-4.5": {
          "name": "Claude 4.5 Opus",
        },
        "opus-4.5-thinking": {
          "name": "Claude 4.5 Opus (Thinking)",
        },
        "sonnet-4.5": {
          "name": "Claude 4.5 Sonnet",
        },
        "sonnet-4.5-thinking": {
          "name": "Claude 4.5 Sonnet (Thinking)",
        },
        "gpt-5.4-high": {
          "name": "GPT-5.4 High",
          "cost": {
            "input": 2.5,
            "output": 15,
            "cache_read": 0.25,
            "cache_write": 2.5,
            "context_over_200k": {
              "input": 5,
              "output": 22.5,
              "cache_read": 0.5,
              "cache_write": 5,
            },
          },
        },
        "gpt-5.4-medium": {
          "name": "GPT-5.4",
          "cost": {
            "input": 2.5,
            "output": 15,
            "cache_read": 0.25,
            "cache_write": 2.5,
            "context_over_200k": {
              "input": 5,
              "output": 22.5,
              "cache_read": 0.5,
              "cache_write": 5,
            },
          },
        },
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "cost": {
            "input": 1.75,
            "output": 14,
            "cache_read": 0.175,
            "cache_write": 1.75,
          },
        },
        "gpt-5.2": {
          "name": "GPT-5.2",
          "cost": {
            "input": 1.75,
            "output": 14,
            "cache_read": 0.175,
            "cache_write": 1.75,
          },
        },
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro",
          "cost": {
            "input": 2,
            "output": 12,
            "cache_read": 0.2,
            "cache_write": 2,
            "context_over_200k": {
              "input": 4,
              "output": 18,
              "cache_read": 0.4,
              "cache_write": 4,
            },
          },
        },
        "gemini-3-pro": {
          "name": "Gemini 3 Pro",
        },
        "gemini-3-flash": {
          "name": "Gemini 3 Flash",
          "cost": {
            "input": 0.5,
            "output": 3,
            "cache_read": 0.05,
            "cache_write": 0.5,
          },
        },
        "grok": {
          "name": "Grok",
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "cost": {
            "input": 0.6,
            "output": 3,
            "cache_read": 0.1,
            "cache_write": 0.6,
          },
        },
      },
    },
  },
}
