{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": "notify",
	"lsp": true,
	"permission": {
		"*": "deny",
		"external_directory": "deny",
		"bash": "deny",
		"edit": "deny",
		"write": "deny",
		"apply_patch": "deny",
		"oc_*": "deny",
		"shell": "deny",
		"ls": "deny",
		"mkdir": "deny",
		"rm": "deny",
		"stat": "deny",
		"compress": "deny",
		"task": "deny",
		"delegate": "deny",
		"delegation_*": "deny",
		"plan_*": "deny",
		"codegraph_*": "deny",
		"context7_*": "deny",
		"exa_*": "deny",
		"gh_grep_*": "deny",
		"kagi_*": "deny",
		"websearch": "deny",
		"webfetch": "deny",
		"skill": "deny",
		"worktree_*": "deny"
	},
	"model": "openai/gpt-5.6-terra",
	"small_model": "openai/gpt-5.6-luna",
	"agent": {
		"researcher": {
			"model": "openai/gpt-5.6-sol",
			"variant": "xhigh",
			"permission": {
				"context7_*": "allow",
				"exa_*": "allow",
				"gh_grep_*": "allow",
				"kagi_*": "deny",
				"websearch": "allow",
				"webfetch": "allow",
				"read": "deny",
				"glob": "deny",
				"grep": "deny",
				"write": "deny",
				"edit": "deny",
				"plan_read": "deny",
				"todoread": "deny",
				"bash": "deny",
				"skill": "deny"
			}
		},
		"scribe": {
			"model": "openai/gpt-5.6-luna",
			"variant": "low",
			"permission": {
				"bash": "deny",
				"edit": {
					"*": "deny",
					"*.md": "allow",
					"**/*.md": "allow",
					"*.mdx": "allow",
					"**/*.mdx": "allow",
					"*.txt": "allow",
					"**/*.txt": "allow",
					"*.rst": "allow",
					"**/*.rst": "allow",
					"*.adoc": "allow",
					"**/*.adoc": "allow"
				},
				"glob": "allow",
				"grep": "allow",
				"read": "allow",
				"write": {
					"*": "deny",
					"*.md": "allow",
					"**/*.md": "allow",
					"*.mdx": "allow",
					"**/*.mdx": "allow",
					"*.txt": "allow",
					"**/*.txt": "allow",
					"*.rst": "allow",
					"**/*.rst": "allow",
					"*.adoc": "allow",
					"**/*.adoc": "allow"
				},
				"skill": {
					"*": "deny",
					"writing-for-agents": "allow"
				},
				"plan_read": "deny",
				"todoread": "deny"
			}
		},
		"coder": {
			"model": "openai/gpt-5.6-luna",
			"variant": "high",
			"permission": {
				"codegraph_*": "allow",
				"context7_*": "deny",
				"exa_*": "deny",
				"gh_grep_*": "deny",
				"read": "allow",
				"write": "allow",
				"edit": "allow",
				"apply_patch": "allow",
				"glob": "allow",
				"grep": "allow",
				"bash": {
					"*": "allow",
					"git add*": "deny",
					"git branch*": "deny",
					"git checkout*": "deny",
					"git cherry-pick*": "deny",
					"git clean*": "deny",
					"git commit*": "deny",
					"git config*": "deny",
					"git fetch*": "deny",
					"git merge*": "deny",
					"git notes*": "deny",
					"git pull*": "deny",
					"git push*": "deny",
					"git rebase*": "deny",
					"git remote*": "deny",
					"git reset*": "deny",
					"git restore*": "deny",
					"git revert*": "deny",
					"git stash*": "deny",
					"git switch*": "deny",
					"git tag*": "deny",
					"git worktree*": "deny",
					"gh pr create*": "deny",
					"glab mr create*": "deny",
					"npm publish*": "deny",
					"bun publish*": "deny",
					"sudo *": "deny"
				},
				"skill": {
					"*": "deny",
					"code-philosophy": "allow",
					"frontend-philosophy": "allow",
					"frontend-design-discipline": "allow",
					"deterministic-diagnosis": "allow",
					"public-seam-tdd": "allow"
				},
				"plan_read": "deny",
				"todoread": "deny"
			}
		},
		"reviewer": {
			"model": "openai/gpt-5.6-terra",
			"variant": "high",
			"temperature": 0.1,
			"permission": {
				"edit": "deny",
				"write": "deny",
				"bash": "deny",
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"plan_read": "allow",
				"delegation_read": "allow",
				"delegation_list": "allow",
				"skill": {
					"*": "deny",
					"code-review": "allow",
					"plan-review": "allow",
					"code-philosophy": "allow",
					"frontend-philosophy": "allow",
					"frontend-design-discipline": "allow"
				}
			}
		},
		"plan": {
			"model": "openai/gpt-5.6-sol",
			"variant": "xhigh",
			"prompt": "You are a READ-ONLY planning orchestrator. Coordinate work; do not implement or search the codebase yourself. Delegate internal codebase questions to `explore` only and external documentation and APIs to `researcher` only. Planning artifacts are saved only with `plan_save`; do not invoke the write-capable `scribe` from plan mode. During implementation, `build` routes human-facing content to `scribe`. `explore` cannot access external resources, `researcher` cannot search codebase files, and neither may be substituted by answering from memory. Planning is read-only: load `plan-protocol`, collaborate on a complete cited plan, and call `plan_save` with the finalized plan before leaving plan mode. When an unresolved design decision belongs to the user, load `grilling` and ask precise questions about evidence, falsifiers, and boundaries; do not use it for settled requirements or to invent a decision. Planning, research, review, and casual chat do not create worktrees. After the user approves implementation, hand off control to the `build` orchestrator; do not spawn it as a subagent. Build is the sole agent responsible for creating and owning the implementation workspace. If this session already belongs to a dedicated worktree, reuse it. `worktree_create` binds the build orchestrator's current session to the new workspace; it does not open a terminal or fork the session. Planning alone does not require a branch, and implementation must never begin in the planning worktree.",
			"permission": {
				"question": "allow",
				"compress": "allow",
				"edit": "deny",
				"write": "deny",
				"bash": "deny",
				"read": "deny",
				"glob": "deny",
				"grep": "deny",
				"codegraph_*": "deny",
				"websearch": "deny",
				"webfetch": "deny",
				"delegate": "allow",
				"delegation_read": "allow",
				"delegation_list": "allow",
				"plan_save": "allow",
				"plan_read": "allow",
				"skill": {
					"*": "deny",
					"plan-protocol": "allow",
					"grilling": "allow"
				},
				"task": {
					"*": "deny"
				},
				"worktree_create": "deny",
				"worktree_*": "deny",
				"worktree_delete": "deny"
			}
		},
		"build": {
			"model": "openai/gpt-5.6-terra",
			"variant": "high",
			"prompt": "You are a BUILD ORCHESTRATOR. You coordinate work; you do NOT implement. Delegate ALL code changes and verification to `coder`, documentation to `scribe`, codebase analysis to `explore` only, and external research to `researcher` only. You may directly inspect Git and perform explicitly authorized final delivery operations described below, but do not edit files or run implementation and verification commands directly. Before writing code, call `plan_read`, call `delegation_list` once, read relevant findings with `delegation_read`, and reuse production-ready research. Load the relevant philosophy before delegating to `coder`; have `coder` run lint, type-check, build, and tests. For an observed or suspected defect, instruct `coder` to use the local `deterministic-diagnosis` skill; for behavior work with a stable public boundary, instruct `coder` to use `public-seam-tdd`. Include either skill only when that condition is present, never for unrelated configuration, documentation, or review work. Delegate a `reviewer` before reporting completion. All implementation requires a dedicated non-default branch in an isolated worktree. If this is the default branch or not a task worktree, invoke `worktree_create` with a descriptive feature/, fix/, or chore/ branch. The tool binds this same build session to the new workspace. After it succeeds, do not call another tool in the current loop; end the response briefly so the plugin can automatically resume this same session in the workspace. From that resumed loop, delegate `coder`, `reviewer`, and other child agents so they share the parent's workspace. Do not fork the session, open another terminal, or terminate the parent session. If the session already belongs to a dedicated worktree, reuse it. `worktree_create` safely adopts an existing valid worktree for the requested branch. If it reports a stale registration or a mismatched existing path, do not retry the same request and never remove or overwrite it automatically; present the detected path and ask the user whether to prune/archive/remove it or use a different branch. This is an explicit approved implementation handoff, not a session-start hook: casual chat, planning, research, and review never create worktrees. Never implement on main, master, trunk, or the remote default branch. Git delivery ownership: build owns final integration after implementation, verification, and review; coder never commits or pushes. Inspect branch, status, and diff directly; stage only intended files and never sweep unrelated dirty-worktree changes into a commit. Ask `scribe` for a commit message when useful. Commit only when the user explicitly requests a commit. Fetch or pull only when explicitly requested or required to resolve known remote divergence, and pulls must use `--ff-only`; never merge or rebase silently. Push only when explicitly requested; never force-push. Create a GitHub pull request with `gh` or a GitLab merge request with `glab` only when explicitly requested, choosing the provider from the Git remote. Report the branch, commit, remote, and PR/MR result precisely. The permission layer asks the user before every staging, commit, fetch, pull, push, or PR/MR creation command; never work around a denial. Before reporting completion, delegate `reviewer` with the changed files and, for branch review, the explicit base ref, merge-base, and diff; include findings and offer to fix critical or major issues. Do not skip review.",
			"permission": {
				"question": "allow",
				"compress": "allow",
				"edit": "deny",
				"write": "deny",
				"bash": {
					"*": "deny",
					"git status*": "allow",
					"git diff*": "allow",
					"git log*": "allow",
					"git branch --show-current*": "allow",
					"git rev-parse*": "allow",
					"git symbolic-ref*": "allow",
					"git remote*": "allow",
					"git add*": "ask",
					"git commit*": "ask",
					"git fetch*": "ask",
					"git pull --ff-only*": "ask",
					"git push*": "ask",
					"gh pr create*": "ask",
					"gh pr view*": "allow",
					"gh pr status*": "allow",
					"glab mr create*": "ask",
					"glab mr view*": "allow",
					"git push*--force*": "deny",
					"git push*-f*": "deny",
					"git push*--mirror*": "deny"
				},
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"delegate": "allow",
				"delegation_read": "allow",
				"delegation_list": "allow",
				"plan_read": "allow",
				"plan_save": "deny",
				"skill": {
					"*": "deny",
					"code-philosophy": "allow",
					"frontend-philosophy": "allow",
					"frontend-design-discipline": "allow"
				},
				"task": {
					"*": "deny",
					"coder": "allow",
					"scribe": "allow"
				},
				"worktree_create": "allow",
				"worktree_*": "allow",
				"worktree_delete": "ask"
			}
		},
		"explore": {
			"model": "openai/gpt-5.6-luna",
			"variant": "low",
			"permission": {
				"codegraph_*": "allow",
				"context7_*": "deny",
				"exa_*": "deny",
				"gh_grep_*": "deny",
				"websearch": "deny",
				"webfetch": "deny",
				"edit": "deny",
				"write": "deny",
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"plan_read": "deny",
				"todoread": "deny",
				"bash": "deny",
				"skill": "deny"
			}
		}
	},
	"mcp": {
		"codegraph": {
			"enabled": true,
			"type": "local",
			"command": ["codegraph", "serve", "--mcp"]
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"exa": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp",
			"enabled": true
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app",
			"enabled": true
		}
	},
	"instructions": [
		"{env:OPENCODE_CONFIG_DIR}/tools/runtime.md",
		"{env:OPENCODE_CONFIG_DIR}/tools/philosophy.md"
	],
	"plugin": [
		"./plugins/ocx/project-instructions.ts",
		"./plugins/ocx/background-agents.ts",
		"./plugins/ocx/worktree.ts",
		"./plugins/ocx/workspace-plugin.ts",
		"./plugins/ocx/notify.ts",
		"./plugins/ocx/dcp.ts",
		"opencode-claude-auth@2.1.6",
		"@franlol/opencode-md-table-formatter@0.0.6"
	],
	"disabled_providers": ["cursor-acp"],
	/*
	 * QUARANTINED: open-cursor 2.5.6 acknowledges that cursor-agent may perform
	 * native side effects before OpenCode receives a tool call, and that its
	 * sandbox did not prevent native edits. Keep these model definitions dormant
	 * until the backend is model-only and every effect crosses OpenCode's tool,
	 * permission, agent, and managed-worktree gates.
	 *
	"provider": {
		"cursor-acp": {
			"name": "Cursor",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://127.0.0.1:32124/v1"
			},
			"models": {
				"gpt-5.3-codex": {
					"name": "Codex 5.3",
					"options": {
						"cursorModel": "gpt-5.3-codex"
					},
					"variants": {
						"low": {
							"cursorModel": "gpt-5.3-codex-low",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"low-fast": {
							"cursorModel": "gpt-5.3-codex-low-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"fast": {
							"cursorModel": "gpt-5.3-codex-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"high": {
							"cursorModel": "gpt-5.3-codex-high",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"high-fast": {
							"cursorModel": "gpt-5.3-codex-high-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"xhigh": {
							"cursorModel": "gpt-5.3-codex-xhigh",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"xhigh-fast": {
							"cursorModel": "gpt-5.3-codex-xhigh-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						}
					},
					"cost": {
						"input": 1.75,
						"output": 14,
						"cache_read": 0.175,
						"cache_write": 1.75
					}
				},
				"gpt-5.2": {
					"name": "GPT-5.2",
					"options": {
						"cursorModel": "gpt-5.2"
					},
					"variants": {
						"low": {
							"cursorModel": "gpt-5.2-low",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"low-fast": {
							"cursorModel": "gpt-5.2-low-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"fast": {
							"cursorModel": "gpt-5.2-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"high": {
							"cursorModel": "gpt-5.2-high",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"high-fast": {
							"cursorModel": "gpt-5.2-high-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"xhigh": {
							"cursorModel": "gpt-5.2-xhigh",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						},
						"xhigh-fast": {
							"cursorModel": "gpt-5.2-xhigh-fast",
							"cost": {
								"input": 1.75,
								"output": 14,
								"cache_read": 0.175,
								"cache_write": 1.75
							}
						}
					},
					"cost": {
						"input": 1.75,
						"output": 14,
						"cache_read": 0.175,
						"cache_write": 1.75
					}
				},
				"cursor-grok-4.6": {
					"name": "Cursor Grok 4.6",
					"options": {
						"cursorModel": "cursor-grok-4.6-medium"
					},
					"variants": {
						"low": {
							"cursorModel": "cursor-grok-4.6-low"
						},
						"low-fast": {
							"cursorModel": "cursor-grok-4.6-low-fast"
						},
						"medium": {
							"cursorModel": "cursor-grok-4.6-medium"
						},
						"medium-fast": {
							"cursorModel": "cursor-grok-4.6-medium-fast"
						},
						"high": {
							"cursorModel": "cursor-grok-4.6-high"
						},
						"high-fast": {
							"cursorModel": "cursor-grok-4.6-high-fast"
						},
						"xhigh": {
							"cursorModel": "cursor-grok-4.6-xhigh"
						},
						"xhigh-fast": {
							"cursorModel": "cursor-grok-4.6-xhigh-fast"
						}
					}
				},
				"composer-2.5": {
					"name": "Composer 2.5",
					"options": {
						"cursorModel": "composer-2.5"
					},
					"variants": {
						"fast": {
							"cursorModel": "composer-2.5-fast"
						}
					}
				},
				"claude-opus-5-thinking": {
					"name": "Claude Opus 5 Thinking",
					"options": {
						"cursorModel": "claude-opus-5-thinking-medium"
					},
					"variants": {
						"low": {
							"cursorModel": "claude-opus-5-thinking-low"
						},
						"low-fast": {
							"cursorModel": "claude-opus-5-thinking-low-fast"
						},
						"medium": {
