						},
						"max-fast": {
							"cursorModel": "claude-opus-5-thinking-max-fast"
						}
					}
				},
				"gpt-5.6-sol": {
					"name": "GPT 5.6 Sol",
					"options": {
						"cursorModel": "gpt-5.6-sol-medium"
					},
					"variants": {
						"none": {
							"cursorModel": "gpt-5.6-sol-none"
						},
						"low": {
							"cursorModel": "gpt-5.6-sol-low"
						},
						"low-fast": {
							"cursorModel": "gpt-5.6-sol-low-fast"
						},
						"medium": {
							"cursorModel": "gpt-5.6-sol-medium"
						},
						"medium-fast": {
							"cursorModel": "gpt-5.6-sol-medium-fast"
						},
						"high": {
							"cursorModel": "gpt-5.6-sol-high"
						},
						"high-fast": {
							"cursorModel": "gpt-5.6-sol-high-fast"
						},
						"xhigh": {
							"cursorModel": "gpt-5.6-sol-xhigh"
						},
						"xhigh-fast": {
							"cursorModel": "gpt-5.6-sol-xhigh-fast"
						},
						"max": {
							"cursorModel": "gpt-5.6-sol-max"
						},
						"max-fast": {
							"cursorModel": "gpt-5.6-sol-max-fast"
						},
						"none-fast": {
							"cursorModel": "gpt-5.6-sol-none-fast"
						}
					}
				},
				"claude-fable-5": {
					"name": "Claude Fable 5",
					"options": {
						"cursorModel": "claude-fable-5-medium"
					},
					"variants": {
						"low": {
							"cursorModel": "claude-fable-5-low"
