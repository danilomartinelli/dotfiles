{
  "$schema": "https://opencode.ai/config.json",
  // The payload of the profile opencode/env.zsh names as the default, rendered
  // by _scripts/render-opencode-profiles from the same sources every other
  // profile is rendered from. Do not edit inside the markers.
  //
  // It is here for hosts that cannot select a profile. `ocx opencode` and
  // bin/opencode-profile both export OPENCODE_CONFIG, which merges the chosen
  // profile OVER this file, so every profile still owns its own routes and the
  // CLI is unaffected. A desktop app opened from the Dock inherits no
  // environment and reaches only this file: without these keys it would start
  // with no model and every delegated agent unrouted.
  // generated: default-profile
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-luna",
  "lsp": true,
  "agent": {
    "plan": {
      "model": "openai/gpt-6-astra",
      "variant": "xhigh"
    },
    "build": {
      "model": "openai/gpt-6-astra",
      "variant": "xhigh"
    },
    "coder": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "researcher": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "scribe": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "reviewer": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    }
  },
  // generated-end
  "mcp": {
    // An Android cold boot is a documented 2-10 minute operation and Argent
    // bounds it itself; OpenCode's own 60s request timeout cut every one of
    // them off at 60.0s and left the tool-server booting a device the caller
    // had already given up on. Cover Argent's own 15-minute ceiling instead.
    "argent": {
      "type": "local",
      "command": ["argent", "mcp"],
      "environment": { "DO_NOT_TRACK": "1" },
      "timeout": 900000,
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "environment": { "CODEGRAPH_TELEMETRY": "0" },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "plugin": [
    // OpenCode ships no Anthropic provider of its own: without this plugin the
    // stored Anthropic OAuth credential is listed by `opencode auth list` and
    // the provider still resolves to "Provider not found". Every anthropic/*
    // route in profiles/_routing.tsv depends on it.
    //
    // The two release lines of this package are not cross-compatible and share
    // one npm name: 1.x on `latest` is the OpenCode v1 plugin, 2.x on `next` is
    // the OpenCode v2 one, which OpenCode 1.x refuses with "must default export
    // an object with server()". Move this pin only with npm:opencode-ai.
    "@ex-machina/opencode-anthropic-auth@1.8.4",
    "@tarquinen/opencode-dcp@3.1.15",
    "@franlol/opencode-md-table-formatter@0.0.6",
    "./orchestrator/index.ts"
  ]
}
