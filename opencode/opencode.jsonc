{
  "$schema": "https://opencode.ai/config.json",
  // The OpenCode desktop app, opened from the Dock, inherits no environment and
  // reads only this file, so the models are stated here rather than left to
  // whichever one a session picked last.
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-luna",
  "lsp": true,
  // Each agent names its model beside the variant: variants are model-specific,
  // and OpenCode v2, which Conductor runs against this same file, drops a
  // variant that arrives without one.
  "agent": {
    "plan": {
      "model": "openai/gpt-6-astra",
      "variant": "xhigh"
    },
    "build": {
      "model": "openai/gpt-6-astra",
      "variant": "xhigh"
    }
  },
  "mcp": {
    // An Android cold boot is a documented 2-10 minute operation and Argent
    // bounds it itself; OpenCode's own 60s request timeout cut every one of
    // them off at 60.0s and left the tool-server booting a device the caller
    // had already given up on. Cover Argent's own 15-minute ceiling instead.
    "argent": {
      "type": "local",
      "command": ["argent", "mcp"],
      "environment": { "DO_NOT_TRACK": "1" },
      "timeout": 900000,
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "environment": { "CODEGRAPH_TELEMETRY": "0" },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      // Unset sends an empty header, which Context7 serves at the anonymous quota.
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "plugin": [
    // OpenCode ships no Anthropic subscription login of its own: without this
    // plugin the stored Anthropic OAuth credential is listed by
    // `opencode auth list` and the provider still resolves to "Provider not
    // found".
    //
    // The two release lines of this package are not cross-compatible and share
    // one npm name: 1.x on `latest` is the OpenCode v1 plugin, 2.x on `next` is
    // the OpenCode v2 one, which OpenCode 1.x refuses with "must default export
    // an object with server()". Move this pin only with npm:opencode-ai.
    "@ex-machina/opencode-anthropic-auth@1.8.6",
    "@tarquinen/opencode-dcp@3.2.0",
    "@franlol/opencode-md-table-formatter@0.0.6"
  ]
}
