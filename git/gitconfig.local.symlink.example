[user]
        name = AUTHORNAME
        email = AUTHOREMAIL
[credential]
        helper = GIT_CREDENTIAL_HELPER
# git/install.sh adds user.signingkey, commit.gpgsign and tag.gpgsign here
# once ~/.ssh/id_ed25519 exists (ssh-key-create default). Set either gpgsign
# to false in this file to keep signing off; the installer leaves a value that
# is already present alone.
