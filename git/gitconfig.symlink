[alias]
        co = checkout
        promote = "!\"$DOTFILES_ROOT/bin/git-promote\""
        wtf     = "!\"$DOTFILES_ROOT/bin/git-wtf\""
        rank-contributors = "!\"$DOTFILES_ROOT/bin/git-rank-contributors\""
        count   = !git shortlog -sn
[core]
        excludesfile = ~/.gitignore
        attributesfile = ~/.gitattributes
        editor = zed --wait
        fsmonitor = true
        untrackedCache = true
        pager = delta
[interactive]
        diffFilter = delta --color-only
[delta]
        navigate = true
        line-numbers = true
        syntax-theme = Catppuccin Macchiato
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = prompt
[diff "spaceman-diff"]
  command = spaceman-diff
[diff]
        algorithm = histogram
        colorMoved = default
        mnemonicPrefix = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
	followTags = true
[rerere]
	enabled = true
	autoUpdate = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[commit]
	verbose = true
# SSH signing infrastructure. Harmless without a key: signing itself is
# enabled per machine via commit.gpgsign in ~/.gitconfig.local.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[column]
	ui = auto
[log]
	date = iso
# Machine-local/private config gets the last word: git keeps the LAST value
# for single-valued options, so this include must stay at the bottom.
[include]
        path = ~/.gitconfig.local
