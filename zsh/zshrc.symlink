# Resolve the checkout containing this startup file, including linked worktrees.
ADAPTER_ANCHOR=${(%):-%N}
# shellcheck disable=SC1091 # Sourced from the checkout beside this startup file.
. "${${ADAPTER_ANCHOR:A}:h:h}/_scripts/adapter-checkout.sh" || return 1

source "$DOTFILES_ROOT/zsh/_startup.zsh"

# sentry
fpath=("/Users/danilomartinelli/.local/share/zsh/site-functions" $fpath)

# Added by Devin
export PATH="/Users/danilomartinelli/.codeium/windsurf/bin:$PATH"
