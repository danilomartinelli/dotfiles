#!/usr/bin/env python3
"""Publish native subagent lifecycles as labels on the invoking Herdr terminal."""

import hashlib
import json
import os
import subprocess
import sys


def short_id(value):
    return hashlib.sha256(value.encode()).hexdigest()[:16]


def publish(provider, terminal, event):
    if not isinstance(event, dict):
        return
    session = event.get("session_id")
    kind = event.get("hook_event_name")
    if not isinstance(session, str) or not session:
        return
    scope = short_id(session)
    if kind == "SessionStart":
        label = f"estro.session.{provider}={scope}"
    elif kind in ("SubagentStart", "SubagentStop"):
        agent = event.get("agent_id")
        if not isinstance(agent, str) or not agent:
            return
        key = f"estro.child.{provider}.{scope}.{short_id(agent)}"
        if kind == "SubagentStop":
            label = f"{key}="
        else:
            role = event.get("agent_type") or "Subagent"
            role = " ".join(str(role).split())[:64]
            label = f"{key}={role}"
    else:
        return
    subprocess.run(["hc", "label", "--", terminal, label], timeout=2, check=False,
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    terminal = os.environ.get("HC_TERMINAL_ID")
    if terminal and sys.argv[1:] in (["claude"], ["codex"]):
        try:
            publish(sys.argv[1], terminal, json.load(sys.stdin))
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass  # Sidebar metadata is optional when the core is unavailable.
