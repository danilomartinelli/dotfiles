{
  "env": {
    "DISABLE_UPDATES": "1"
  },
  "model": "claude-fable-5-2",
  "disableClaudeAiConnectors": true,
  "deniedMcpServers": [
    {
      "serverName": "aws-mcp"
    },
    {
      "serverName": "node_repl"
    },
    {
      "serverName": "linear"
    },
    {
      "serverName": "supabase"
    },
    {
      "serverName": "plugin:aws-agents-for-devsecops:aws-devops-agent"
    },
    {
      "serverName": "plugin:aws-agents:awsknowledge"
    },
    {
      "serverName": "plugin:aws-core:aws-mcp"
    },
    {
      "serverName": "plugin:aws-data-analytics:aws-mcp"
    },
    {
      "serverName": "plugin:engineering:atlassian"
    },
    {
      "serverName": "plugin:engineering:datadog"
    },
    {
      "serverName": "plugin:engineering:gmail"
    },
    {
      "serverName": "plugin:engineering:google calendar"
    },
    {
      "serverName": "plugin:engineering:linear"
    },
    {
      "serverName": "plugin:engineering:notion"
    },
    {
      "serverName": "plugin:engineering:slack"
    },
    {
      "serverName": "plugin:finance:databricks"
    },
    {
      "serverName": "plugin:finance:gmail"
    },
    {
      "serverName": "plugin:finance:google calendar"
    },
    {
      "serverName": "plugin:finance:snowflake"
    },
    {
      "serverName": "plugin:finance:slack"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/danilomartinelli/.claude/skills/impeccable/scripts/impeccable' ] || '/Users/danilomartinelli/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/danilomartinelli/.claude/skills/impeccable/scripts/impeccable' ] || '/Users/danilomartinelli/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/danilomartinelli/.claude/skills/impeccable/scripts/impeccable' ] || '/Users/danilomartinelli/.claude/skills/impeccable/scripts/impeccable' hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "postman@claude-plugins-official": true,
    "posthog@posthog": true,
    "frontend-slides@frontend-slides": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "pm-skills": {
      "source": {
        "source": "github",
        "repo": "phuryn/pm-skills"
      }
    },
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    },
    "posthog": {
      "source": {
        "source": "github",
        "repo": "PostHog/ai-plugin"
      }
    },
    "frontend-slides": {
      "source": {
        "source": "git",
        "url": "https://github.com/zarazhangrui/frontend-slides.git"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
