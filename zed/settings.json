{
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "default_model": {
      "provider": "opencode",
      "model": "go/minimax-m3",
      "enable_thinking": false
    },
    "sandbox_permissions": {
      "network_hosts": [
        "registry.npmjs.org",
        "formulae.brew.sh"
      ],
      "write_paths": [
        {
          "requested": "/Users/danilomartinelli/.local/share/mise/installs/npm-anthropic-ai-claude-code",
          "resolved": "/Users/danilomartinelli/.local/share/mise/installs/npm-anthropic-ai-claude-code"
        },
        {
          "requested": "/Users/danilomartinelli/.local/share/mise/installs/npm-opencode-ai",
          "resolved": "/Users/danilomartinelli/.local/share/mise/installs/npm-opencode-ai"
        },
        {
          "requested": "/Users/danilomartinelli/.codex",
          "resolved": "/Users/danilomartinelli/.codex"
        },
        {
          "requested": "/Users/danilomartinelli/.local/share/mise/installs/npm-opencode-ai/1.18.14/node_modules/.mise/opencode-ai@1.18.14/node_modules/opencode-ai/bin",
          "resolved": "/Users/danilomartinelli/.cache/aube/virtual-store/opencode-ai@1.18.14-dd8686a910b10b5e/node_modules/opencode-ai/bin"
        }
      ]
    },
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    }
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  // Homebrew owns updates (cask); self-updating would drift from the Brewfile.
  "auto_update": false,
  "base_keymap": "VSCode",
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "relative_line_numbers": "disabled",
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "project_panel": {
    "dock": "left",
    "git_status": true,
  },
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "env": {
      "EDITOR": "zed --wait",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store",
    "**/.context",
    "**/.next",
    "**/.turbo",
    "**/.venv",
    "**/node_modules",
    "**/dist",
    "**/out",
    "**/_build",
    "**/deps",
    "**/.elixir_ls",
    "**/target",
  ],
  // Secrets never reach the assistant context or previews.
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/id_*",
    "**/secrets.yml",
  ],
  "languages": {
    "JavaScript": {
      "prettier": { "allowed": true },
    },
    "TypeScript": {
      "prettier": { "allowed": true },
      "inlay_hints": { "enabled": false },
      // organizeImports is deliberately absent: pruning "unused" imports on
      // save fights with in-progress edits.
      "code_actions_on_format": { "source.fixAll.eslint": true },
    },
    "TSX": {
      "prettier": { "allowed": true },
      "inlay_hints": { "enabled": false },
      "code_actions_on_format": { "source.fixAll.eslint": true },
    },
    "JSON": {
      "prettier": { "allowed": true },
    },
    "JSONC": {
      "prettier": { "allowed": true },
    },
    "Markdown": {
      "prettier": { "allowed": true },
    },
    "YAML": {
      "prettier": { "allowed": true },
    },
    "Elixir": {
      "tab_size": 2,
    },
    "Python": {
      "tab_size": 4,
    },
    // The Zed nix extension registers two language servers, nil and nixd.
    // `language_servers` is a priority list, NOT a fallback chain: every
    // server left enabled runs concurrently, so listing both would produce
    // duplicate diagnostics and completions. nixd is kept because it
    // evaluates the flake and resolves real option names; nil is disabled
    // explicitly with `!` rather than merely omitted, so a future extension
    // update cannot silently re-enable it.
    //
    // Neither ships as a Homebrew formula or a release binary — `nix-install`
    // provisions nixd from nixpkgs. Until it runs, .nix files still get
    // tree-sitter highlighting and nixfmt on save, but no LSP features.
    "Nix": {
      "tab_size": 2,
      "language_servers": ["nixd", "!nil"],
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": [],
        },
      },
    },
  },
}
