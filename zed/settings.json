{
  "context_servers": {
    "browser-tools-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {}
    },
    "mcp-server-brave-search": {
      "settings": {},

      "enabled": true,
      "remote": false
    },
    "mcp-server-context7": {
      "settings": {},

      "enabled": true,
      "remote": false
    },
    "mcp-server-github": {
      "settings": {},

      "enabled": true,
      "remote": false
    }
  },
  "edit_predictions": {
    "provider": "copilot",
    "allow_data_collection": "no"
  },
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "build"
      },
      "type": "custom",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "ocx",
        "opencode",
        "-p",
        "regular",
        "--no-rename",
        "acp"
      ]
    },
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6-astra",
        "mode": "agent-full-access",
        "reasoning_effort": "xhigh"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "mode": "bypassPermissions",
        "model": "claude-opus-5[1m]"
      },
      "type": "registry"
    }
  },
  "agent": {
    "auto_compact": {
      "threshold": "80%"
    },
    "default_model": {
      "effort": "xhigh",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true
    },
    "sandbox_permissions": {
      "allow_fs_write_all": true,
      "allow_all_hosts": true,
      "network_hosts": ["registry.npmjs.org", "formulae.brew.sh"],
      "write_paths": [
        {
          "requested": "/Users/danilomartinelli/.local/share/mise/installs/npm-anthropic-ai-claude-code",
          "resolved": "/Users/danilomartinelli/.local/share/mise/installs/npm-anthropic-ai-claude-code"
        },
        {
          "requested": "/Users/danilomartinelli/.local/share/mise/installs/npm-opencode-ai",
          "resolved": "/Users/danilomartinelli/.local/share/mise/installs/npm-opencode-ai"
        },
        {
          "requested": "/Users/danilomartinelli/.codex",
          "resolved": "/Users/danilomartinelli/.codex"
        }
      ]
    },
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "create_directory": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    }
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato"
  },
  // Homebrew owns updates (cask); self-updating would drift from the Brewfile.
  "auto_update": false,
  "base_keymap": "VSCode",
  "vim_mode": false,
  // Reopen what was open. A machine move restores the workspace rather than an
  // empty window, and closing the last tab keeps the window so the dock entry
  // still leads somewhere.
  "restore_on_startup": "last_session",
  "when_closing_with_no_tabs": "keep_window_open",
  "confirm_quit": false,
  "use_smartcase_search": true,
  // Panels for features this setup does not use. Hiding the buttons is the
  // whole change: the features stay available from the command palette.
  "collaboration_panel": {
    "button": false
  },
  "chat_panel": {
    "button": "never"
  },
  "notification_panel": {
    "button": false
  },
  "minimap": {
    "show": "auto",
    "thumb": "always",
    "current_line_highlight": "all"
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "search_results": true,
    "selected_symbol": true,
    "diagnostics": "all",
    "cursors": true
  },
  // Blame on the line under the cursor, with the commit summary, because the
  // question a blame answers here is "why", not "who".
  "git": {
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true
    },
    "hunk_style": "staged_hollow"
  },
  // Diagnostics beside the code rather than only in the panel. Warnings are
  // included: this repository's shellcheck and eslint findings are warnings.
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150
    }
  },
  // 80 is what mdformat wraps Markdown to and what the shell files here keep;
  // 100 is the second guide for TypeScript.
  "wrap_guides": [80, 100],
  "show_wrap_guides": true,
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "relative_line_numbers": "disabled",
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": true
  },
  "project_panel": {
    "dock": "left",
    "git_status": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "env": {
      "EDITOR": "zed --wait"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  // Names this repository invents, which no extension can be expected to know.
  // Only those: `*.jsonc`, `*.toml` and `*.zsh` are already mapped by Zed, and
  // restating them here would put a second owner on something that works. The
  // `_*.tsv` catalogs are plain rows rather than a language, so they keep the
  // default. `.prettierrc.json` is strict JSON on purpose and is not listed:
  // `jq` reads it in tests/zed_settings_test.sh.
  "file_types": {
    "Shell Script": ["*.symlink", ".localrc", ".localrc.example", ".commonrc"],
    "Ruby": ["Brewfile"],
    "JSONC": ["*.keyclu"]
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store",
    "**/.context",
    "**/.next",
    "**/.turbo",
    "**/.venv",
    "**/node_modules",
    "**/dist",
    "**/out",
    "**/_build",
    "**/deps",
    "**/.elixir_ls",
    "**/target",
    // Generated or agent-owned trees. `.opencode-artifacts` is a delegation's
    // evidence directory: it is Git-ignored by its own marker, it is where the
    // orchestrator's build output lands, and indexing one costs more than every
    // other exclusion here combined.
    "**/.opencode-artifacts",
    "**/.codegraph",
    "**/.wrangler",
    "**/.direnv",
    "**/.gradle",
    "**/Pods",
    "**/.expo"
  ],
  // Secrets never reach the assistant context or previews.
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/id_*",
    "**/secrets.yml",
    // The machine-private half this repository draws a boundary around:
    // .localrc, the generated Git identity, age identities, and kubeconfigs.
    "**/.localrc",
    "**/gitconfig.local*",
    "**/*.age",
    "**/*_rsa",
    "**/*_ed25519",
    "**/kubeconfig*",
    "**/*.kubeconfig"
  ],
  // Server-specific options. These cannot live under `languages`: that key
  // selects which servers run, this one configures them.
  "lsp": {
    "gopls": {
      "initialization_options": {
        "usePlaceholders": true,
        "staticcheck": true,
        "analyses": {
          "unusedparams": true,
          "unusedwrite": true,
          "nilness": true,
          "shadow": false
        },
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": false,
          "rangeVariableTypes": true
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "inlayHints": {
          "closureReturnTypeHints": { "enable": "with_block" },
          "parameterHints": { "enable": false }
        }
      }
    },
    // Ruff reads pyproject.toml/ruff.toml from the project; nothing is pinned
    // here so a repository's own configuration stays the authority.
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "diagnosticMode": "openFilesOnly",
            "typeCheckingMode": "standard"
          }
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "prettier": { "allowed": true }
    },
    "TypeScript": {
      "prettier": { "allowed": true },
      "inlay_hints": { "enabled": false },
      // organizeImports is deliberately absent: pruning "unused" imports on
      // save fights with in-progress edits.
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    "TSX": {
      "prettier": { "allowed": true },
      "inlay_hints": { "enabled": false },
      "code_actions_on_format": { "source.fixAll.eslint": true }
    },
    // Zed uses its managed Prettier for both formats. The repository-level
    // .prettierrc.json keeps *.jsonc output compatible with strict parsers.
    "JSON": {
      "prettier": { "allowed": true }
    },
    "JSONC": {
      "prettier": { "allowed": true }
    },
    // Markdown is formatted with mdformat, not Prettier. `mdformat --check` is
    // what the repository static checks enforce, and Prettier's Markdown output
    // does not satisfy it, so leaving Prettier on here silently drifts every
    // file away from the checked-in format. Both mdformat plugins matter — a
    // bare installation mangles YAML frontmatter and GFM tables — so the
    // Mise-declared one is reached through `mise exec` rather than trusting
    // whatever PATH Zed inherits, matching agent_servers.opencode above.
    //
    // Registry-backed Markdown under opencode/{agents,commands,skills,tools}
    // must stay byte-identical to its OCX receipt. Saving one of those files
    // here would reformat it, so update them with OCX instead of the editor.
    "Markdown": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "mise",
          "arguments": ["exec", "--", "mdformat", "-"]
        }
      }
    },
    "YAML": {
      "prettier": { "allowed": true }
    },
    // The flags mirror the repository shfmt invocation exactly: -i 2 -ci -bn.
    // --filename lets shfmt infer the dialect from the path instead of guessing
    // it from a buffer that reaches the formatter on stdin.
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "mise",
          "arguments": [
            "exec",
            "--",
            "shfmt",
            "--filename",
            "{buffer_path}",
            "-i",
            "2",
            "-ci",
            "-bn"
          ]
        }
      }
    },
    // Like the Nix entry below, `language_servers` is a priority list and not a
    // fallback chain: every server left enabled runs at once and duplicates
    // diagnostics. Each unwanted one is disabled with `!` rather than merely
    // omitted, so an extension update cannot silently re-enable it.
    //
    // The Zed elixir extension registers five servers -- dexter, elixir-ls,
    // expert, lexical and next-ls -- and left alone it runs whichever ones it
    // defaults to. elixir-ls is the one named here because it is the one this
    // machine has already downloaded and runs today; expert is its maintained
    // successor and switching is a one-word edit, but doing it blind would
    // trade a working server for a download that has never been attempted.
    // Formatting stays with `mix format`, which the server runs, so no external
    // formatter is declared: the project's .formatter.exs is the authority.
    "Elixir": {
      "tab_size": 2,
      "language_servers": [
        "elixir-ls",
        "!expert",
        "!dexter",
        "!next-ls",
        "!lexical"
      ]
    },
    // Ruff both lints and formats; basedpyright supplies types. Ruff is named
    // as the formatter explicitly because with both servers enabled either one
    // could claim the buffer, and pyright's formatting is not Ruff's.
    "Python": {
      "tab_size": 4,
      "language_servers": ["basedpyright", "ruff", "!pyright", "!pylsp"],
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    },
    // gopls is the only Go server, so the list only records that. Imports are
    // organized on format because gofmt does not add or drop an import and
    // `goimports` behaviour is what the toolchain expects on save.
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "Rust": {
      "tab_size": 4
    },
    // The Zed nix extension registers two language servers, nil and nixd.
    // `language_servers` is a priority list, NOT a fallback chain: every
    // server left enabled runs concurrently, so listing both would produce
    // duplicate diagnostics and completions. nixd is kept because it
    // evaluates the flake and resolves real option names; nil is disabled
    // explicitly with `!` rather than merely omitted, so a future extension
    // update cannot silently re-enable it.
    //
    // Neither ships as a Homebrew formula or a release binary — `nix-install`
    // provisions nixd from nixpkgs. Until it runs, .nix files still get
    // tree-sitter highlighting and nixfmt on save, but no LSP features.
    "Nix": {
      "tab_size": 2,
      "language_servers": ["nixd", "!nil"],
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": []
        }
      }
    }
  }
}
