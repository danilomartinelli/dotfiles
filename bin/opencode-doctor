#!/bin/sh
#
# Report and repair the OpenCode runtime state nothing else prunes.
#
# opencode/_doctor.sh owns the behavior and opencode/_runtime-conditions.tsv
# declares what it inspects; opencode/README.md renders that catalog. Listing
# the conditions here as well is what let this file fall four behind them.
#
# Examples
#
#   opencode-doctor
#   opencode-doctor --fix
#   opencode-doctor --fix --days 14
#   opencode-doctor --fix --days 0 --clear-logs

set -e

# shellcheck disable=SC1091 # Loaded from the adapter checkout beside this script.
. "$(CDPATH='' cd -P -- "$(dirname -- "$0")/../_scripts" && pwd)/adapter-checkout.sh"

exec "$DOTFILES_ROOT/opencode/_doctor.sh" "$@"
