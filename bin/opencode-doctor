#!/bin/sh
#
# Report and repair the OpenCode runtime state nothing else prunes: the
# replication event log, processes left inside an agent worktree, workspace
# rows describing a directory that is gone, and an untracked configuration
# file shadowing a managed one.
#
# Examples
#
#   opencode-doctor
#   opencode-doctor --fix
#   opencode-doctor --fix --days 14
#   opencode-doctor --fix --days 0 --clear-logs

set -e

# shellcheck disable=SC1091 # Loaded from the adapter checkout beside this script.
. "$(CDPATH='' cd -P -- "$(dirname -- "$0")/../_scripts" && pwd)/adapter-checkout.sh"

exec "$DOTFILES_ROOT/opencode/_doctor.sh" "$@"
