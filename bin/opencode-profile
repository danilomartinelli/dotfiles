#!/bin/sh
#
# opencode-profile
#
# Runs OpenCode with an OCX profile's configuration applied, for hosts that
# spawn the binary directly instead of going through `ocx opencode`.
#
# A host that asks for a path to the OpenCode binary execs it without a login
# shell, so it sees neither the topic environment nor the profile that `ocx`
# merges in at launch. `ocx opencode` cannot fill that slot: it consumes -h, -v,
# and --version itself and prints its profile banner on stdout, which the host
# then reads as command output.
#
# The opencode-desktop app is not such a host -- it embeds the runtime and reads
# ~/.config/opencode itself -- which is why opencode/opencode.jsonc carries the
# default profile's routing. This adapter remains how anything that does spawn
# the binary, and how `opencode models <provider> --verbose`, reaches a profile.
#
# OPENCODE_CONFIG merges over the global ~/.config/opencode/opencode.jsonc
# instead of replacing it, retaining common MCP servers and plugins. Project
# discovery stays enabled; the runtime pins routes from the selected profile.
#
# USAGE:
#   opencode-profile [opencode arguments...]
#   OCX_PROFILE=example opencode-profile [opencode arguments...]

set -eu

# shellcheck disable=SC1091 # Loaded from the adapter checkout beside this script.
. "$(CDPATH='' cd -P -- "$(dirname -- "$0")/../_scripts" && pwd)/adapter-checkout.sh"

# opencode/env.zsh is the single declaration of every OPENCODE_* value and of
# the default profile, so it is sourced rather than copied here. It must stay
# POSIX-sourceable for that reason. An explicit OCX_PROFILE still wins.
requested_profile=${OCX_PROFILE:-}
# shellcheck disable=SC1091 # Loaded from the resolved dotfiles checkout.
. "$DOTFILES_ROOT/opencode/env.zsh"
# This adapter runs OpenCode directly: OCX has not merged project configuration.
export OPENCODE_DISABLE_PROJECT_CONFIG=false
if [ -n "$requested_profile" ]; then
  OCX_PROFILE=$requested_profile
  export OCX_PROFILE
fi

unset OPENCODE_CONFIG DOTFILES_OPENCODE_PROFILE_CONFIG
profile_config=$HOME/.config/opencode/profiles/$OCX_PROFILE/opencode.jsonc
if [ -f "$profile_config" ]; then
  OPENCODE_CONFIG=$profile_config
  # The runtime restores this profile's routes after native project merging.
  DOTFILES_OPENCODE_PROFILE_CONFIG=$profile_config
  export OPENCODE_CONFIG DOTFILES_OPENCODE_PROFILE_CONFIG
else
  printf 'opencode-profile: no configuration for profile %s; using the global one only\n' \
    "$OCX_PROFILE" >&2
fi

brew_prefix=$("$DOTFILES_ROOT/homebrew/_availability.sh" prefix --fallback 2>/dev/null) || brew_prefix=
mise_binary=$brew_prefix/bin/mise

if [ ! -x "$mise_binary" ]; then
  echo "opencode-profile: mise not found; install it with 'brew bundle'." >&2
  exit 1
fi

opencode_binary=$("$mise_binary" which opencode 2>/dev/null) || opencode_binary=
if [ -z "$opencode_binary" ] || [ ! -x "$opencode_binary" ]; then
  echo "opencode-profile: opencode not installed; run 'mise install'." >&2
  exit 1
fi

# GUI hosts inherit no login-shell PATH. Mise supplies the configured runtimes
# and package CLIs to OpenCode's MCP/LSP/shell children; Homebrew supplies system
# CLIs. Keep the resolved OpenCode binary and pass its arguments unchanged.
PATH="$brew_prefix/bin:$brew_prefix/sbin:$PATH"

# The Android SDK installs outside both, so adb and the emulator reached those
# children only when the GUI host happened to resolve a login shell first. Ask
# the topic that owns the location instead of depending on that.
ANDROID_HOME=$("$DOTFILES_ROOT/android-studio/_sdk.sh" root 2>/dev/null) \
  || ANDROID_HOME=
if [ -n "$ANDROID_HOME" ]; then
  export ANDROID_HOME
  if android_path=$("$DOTFILES_ROOT/android-studio/_sdk.sh" path 2>/dev/null); then
    PATH="$PATH:$android_path"
  fi
fi
export PATH
exec "$mise_binary" exec --no-deps -- "$opencode_binary" "$@"
