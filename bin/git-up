#!/bin/sh
#
# Pull and show the commits received. Any arguments are passed to `git pull`, so
# `git up --rebase` is supported without a separate adapter.

set -e

# shellcheck disable=SC1091 # Loaded from the adapter checkout beside this script.
. "$(CDPATH='' cd -P -- "$(dirname -- "$0")/../_scripts" && pwd)/adapter-checkout.sh"

# shellcheck disable=SC1091 # Loaded from the resolved dotfiles checkout.
. "$DOTFILES_ROOT/git/_branch-state.sh"

_dotfiles_git_state_require_worktree git

before=$(git rev-parse HEAD)
git pull "$@"
after=$(git rev-parse HEAD)

if [ "$before" = "$after" ]; then
  echo 'No new commits.'
  exit 0
fi

# ORIG_HEAD marks where HEAD was before the pull, so a rebase pull does not
# list rewritten local commits as incoming.
echo 'Log:'
git log --color --pretty=oneline --abbrev-commit ORIG_HEAD..HEAD \
  | sed 's/^/  /'
