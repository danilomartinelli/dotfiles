#!/bin/sh
#
# Pull and show the commits received. Any arguments are passed to `git pull`, so
# `git up --rebase` is supported without a separate adapter.

set -e

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo 'Error: Not in a git repository.' >&2
  exit 1
fi

before=$(git rev-parse HEAD)
git pull "$@"
after=$(git rev-parse HEAD)

if [ "$before" = "$after" ]; then
  echo 'No new commits.'
  exit 0
fi

echo 'Log:'
git log --color --pretty=oneline --abbrev-commit "$before..$after" |
  sed 's/^/  /'
