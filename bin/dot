#!/bin/sh
#
# Daily dotfiles update adapter.

set -e

display_usage() {
  cat <<'EOF'
dot -- dotfiles management

Usage: dot [options]

Options:
  -e, --edit    Open dotfiles directory for editing
  -h, --help    Show this help message and exit
EOF
}

operation=update
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      display_usage
      exit 0
      ;;
    -e|--edit)
      operation=edit
      ;;
    *)
      printf 'Invalid option: %s\n' "$1" >&2
      display_usage >&2
      exit 2
      ;;
  esac
  shift
done

ROOT_RESOLVER=$HOME/.dotfiles-root
if [ ! -L "$ROOT_RESOLVER" ] || [ ! -x "$ROOT_RESOLVER" ]; then
  SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$0")" && pwd)
  ROOT_RESOLVER=$SCRIPT_DIR/../dotfiles-root.symlink
fi

DOTFILES_ROOT=$("$ROOT_RESOLVER" "$0")
export DOTFILES_ROOT

if [ "$operation" = edit ]; then
  exec "$EDITOR" "$DOTFILES_ROOT"
fi

exec "$DOTFILES_ROOT/_scripts/setup" update
