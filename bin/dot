#!/bin/sh
#
# Daily dotfiles update adapter.

set -e

display_usage() {
  cat <<'EOF'
dot -- dotfiles management

Usage: dot [options]

Options:
  -e, --edit    Open dotfiles directory for editing
  -h, --help    Show this help message and exit
EOF
}

operation=update
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      display_usage
      exit 0
      ;;
    -e | --edit)
      operation=edit
      ;;
    *)
      printf 'Invalid option: %s\n' "$1" >&2
      display_usage >&2
      exit 2
      ;;
  esac
  shift
done

# shellcheck disable=SC1091 # Loaded from the adapter checkout beside this script.
. "$(CDPATH='' cd -P -- "$(dirname -- "$0")/../_scripts" && pwd)/adapter-checkout.sh"

if [ "$operation" = edit ]; then
  # $EDITOR may carry flags (e.g. "zed --wait"); word-splitting is deliberate.
  # shellcheck disable=SC2086
  exec ${EDITOR:-vi} "$DOTFILES_ROOT"
fi

exec "$DOTFILES_ROOT/_scripts/setup" update
