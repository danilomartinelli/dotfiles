#!/bin/sh
#
# Daily dotfiles update adapter.

set -e

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
DOTFILES_ROOT=$(dirname "$SCRIPT_DIR")

display_usage() {
  cat <<'EOF'
dot -- dotfiles management

Usage: dot [options]

Options:
  -e, --edit    Open dotfiles directory for editing
  -h, --help    Show this help message and exit
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      display_usage
      exit 0
      ;;
    -e|--edit)
      exec "$EDITOR" "$DOTFILES_ROOT"
      ;;
    *)
      printf 'Invalid option: %s\n' "$1" >&2
      display_usage >&2
      exit 0
      ;;
  esac
done

exec "$DOTFILES_ROOT/_scripts/setup" update
