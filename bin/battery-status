#!/bin/sh
#
# battery-status
#
# A quick little indicator for battery status on your Mac laptop, suitable for
# display in your prompt.

if [ "$(uname)" != "Darwin" ]; then
  printf ""
  exit 0
fi

battstat=$(pmset -g batt)
time_left=$(
  echo "$battstat" \
    | tail -1 \
    | cut -f2 \
    | awk -F"; " '{print $3}' \
    | cut -d' ' -f1
)

case "$(pmset -g ac)" in
  *"No adapter attached."*) emoji='🔋' ;;
  *) emoji='🔌' ;;
esac

case $time_left in
  *"(no"* | *"not"*) time_left='⌛️ ' ;;
esac

case $time_left in
  *"0:00"*) time_left='⚡️ ' ;;
esac

printf '\033[1;92m%s  %s \033[0m' "$emoji" "$time_left"
