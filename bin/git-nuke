#!/bin/sh
#
# Nukes a branch locally and on the origin remote.
#
# $1 - Branch name.
#
# Examples
#
#   git nuke add-git-nuke

set -e

if [ -z "$1" ]; then
  echo "Error: Branch name required." >&2
  echo "Usage: git nuke <branch-name>" >&2
  exit 1
fi

ROOT_RESOLVER=$HOME/.dotfiles-root
if [ ! -L "$ROOT_RESOLVER" ] || [ ! -x "$ROOT_RESOLVER" ]; then
  SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$0")" && pwd)
  ROOT_RESOLVER=$SCRIPT_DIR/../dotfiles-root.symlink
fi
DOTFILES_ROOT=$("$ROOT_RESOLVER" "$0")
export DOTFILES_ROOT

# shellcheck disable=SC1091 # Loaded from the resolved dotfiles checkout.
. "$DOTFILES_ROOT/git/_branch-state.sh"

_dotfiles_git_state_require_worktree git

# Never nuke the protected or current branches.
current=$(_dotfiles_git_state_current_branch git 2>/dev/null || true)
case $1 in
  main | master)
    echo "Error: Refusing to nuke protected branch '$1'." >&2
    exit 1
    ;;
  "$current")
    echo "Error: Refusing to nuke the current branch '$1'." >&2
    exit 1
    ;;
esac

# Check if branch exists locally
if ! _dotfiles_git_state_local_branch_exists git "$1"; then
  echo "Warning: Branch '$1' does not exist locally." >&2
else
  git branch -D "$1"
fi

# Try to delete the exact remote branch (it may not exist, which is fine).
remote_status=0
_dotfiles_git_state_live_origin_branch_exists git "$1" || remote_status=$?
case $remote_status in
  0) git push origin --delete "$1" ;;
  1) echo "Info: Branch '$1' does not exist on origin." >&2 ;;
  *) exit "$remote_status" ;;
esac
