#!/bin/sh
#
# Delete local branches merged into HEAD, preserving the current branch and the
# conventional main/master branches. Git's non-forced delete remains the final
# safety check.

set -eu

# shellcheck disable=SC1091 # Loaded from the adapter checkout beside this script.
. "$(CDPATH='' cd -P -- "$(dirname -- "$0")/../_scripts" && pwd)/adapter-checkout.sh"
# shellcheck disable=SC1091 # Loaded from the resolved dotfiles checkout.
. "$DOTFILES_ROOT/git/_branch-state.sh"

_dotfiles_git_state_require_worktree git
current_branch=$(_dotfiles_git_state_current_branch_or_empty git)

git for-each-ref --merged=HEAD --format='%(refname:short)' refs/heads/ \
  | while IFS= read -r branch; do
    case "$branch" in
      '' | "$current_branch" | main | master) continue ;;
    esac

    git branch -d -- "$branch"
  done
