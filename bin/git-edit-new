#!/bin/sh
#
# Open new, unstaged files in your $EDITOR.
#
# This is nice to have when you run a command line generator which generates a
# file or three in your working directory, and you know you want to immediately
# edit them in your editor next. Why waste time clicking around like some sort
# of plebian when you can just run another command?

set -e

# shellcheck disable=SC1091 # Loaded from the adapter checkout beside this script.
. "$(CDPATH='' cd -P -- "$(dirname -- "$0")/../_scripts" && pwd)/adapter-checkout.sh"

# shellcheck disable=SC1091 # Loaded from the resolved dotfiles checkout.
. "$DOTFILES_ROOT/git/_branch-state.sh"

_dotfiles_git_state_require_worktree git

if [ -z "$EDITOR" ]; then
  echo "Error: \$EDITOR is not set." >&2
  exit 1
fi

if [ -z "$(git ls-files --others --exclude-standard)" ]; then
  echo "No new, unstaged files found."
  exit 0
fi

# $EDITOR may carry flags (e.g. "zed --wait"); word-splitting is deliberate.
# shellcheck disable=SC2086
git ls-files --others --exclude-standard -z | xargs -0 $EDITOR
