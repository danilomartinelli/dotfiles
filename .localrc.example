#!/usr/bin/env zsh
# Local configuration for environment-specific settings
# The bootstrap script will automatically create a copy of this file
# as .localrc and symlink it to ~/.localrc
#
# This file holds values that belong to this Mac alone. It is not where
# credentials go: every shell sources it, so anything exported here reaches
# every process started from a shell, coding agents included. See "Secrets" at
# the end of this file.
#
# Setup (handled by bootstrap):
#   1. Copies .localrc.example → .localrc
#   2. Creates symlink .localrc → ~/.localrc
#   3. Sets proper permissions (600)
#
# Manual editing after bootstrap:
#   nvim "$DOTFILES_ROOT/.localrc"  # or nvim ~/.localrc (both work with symlink)
#
# After editing, reload your shell:
#   source ~/.zshrc
#   # or use the alias: reload!

# =======================================
# Machine defaults (non-secret)
# =======================================

# Do not set LANG or LC_* here: ~/.zshenv sets the locale for a person's shell
# or a tool shell, and a shell an app captures runs this file after it.

# Override the shared workspace / projects directories if needed
# export WORKSPACE="$HOME/Workspace"
# export PROJECTS="$WORKSPACE/github.com"

# Optional identity hints used by some CLIs (Git still uses gitconfig.local)
# export GIT_AUTHOR_NAME="Your Name"
# export GIT_AUTHOR_EMAIL="you@example.com"
# export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
# export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# Optional contact / tooling defaults
# export EMAIL="you@example.com"
# export USERNAME="yourhandle"
# GitHub handle used by workspace/install.sh for ~/Workspace/github.com/<user>
# export GITHUB_USER="yourhandle"
# export GITLAB_USER="yourhandle"

# =======================================
# Secrets
# =======================================
#
# Do not export a credential here. There are two kinds, and each has a place
# that reaches only what needs it:
#
# 1. A project secret belongs to one project. Keep it in that project, in a
#    SOPS-encrypted `secrets.sops.env`, and load it with an `.envrc` that says
#    `use sops`. direnv puts it in the environment only inside that directory.
#
# 2. A provider key belongs to an account and a tool needs it wherever it
#    runs, such as OpenCode's model providers. Keep it in Bitwarden, in a
#    secure note named `dotfiles/provider-keys/<tool>` holding KEY=value lines,
#    and run `provider-keys-sync`. `with-provider-keys <tool> -- <command>`
#    then gives the keys to that one command; `opencode` already starts that
#    way.
#
# README.md, "Secrets", describes both.
#
# Git name and email for commits belong in git/gitconfig.local.symlink
# (created by bootstrap). The GIT_* exports above are optional extras.
