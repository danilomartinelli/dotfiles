#!/usr/bin/env zsh
# Local configuration for environment-specific settings
# The bootstrap script will automatically create a copy of this file
# as .localrc and symlink it to ~/.localrc
#
# WARNING: Never commit .localrc with sensitive data to version control!
# This file should contain sensitive information like API keys and passwords.
#
# Setup (handled by bootstrap):
#   1. Copies .localrc.example → .localrc
#   2. Creates symlink .localrc → ~/.localrc
#   3. Sets proper permissions (600)
#
# Manual editing after bootstrap:
#   zed "$DOTFILES_ROOT/.localrc"  # or zed ~/.localrc (both work with symlink)
#
# After editing, reload your shell:
#   source ~/.zshrc
#   # or use the alias: reload!

# =======================================
# Machine defaults (non-secret)
# =======================================

# Override the shared workspace / projects directories if needed
# export WORKSPACE="$HOME/Workspace"
# export PROJECTS="$WORKSPACE/github.com"

# Optional identity hints used by some CLIs (Git still uses gitconfig.local)
# export GIT_AUTHOR_NAME="Your Name"
# export GIT_AUTHOR_EMAIL="you@example.com"
# export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
# export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# Optional contact / tooling defaults
# export EMAIL="you@example.com"
# export USERNAME="yourhandle"
# GitHub handle used by workspace/install.sh for ~/Workspace/github.com/<user>
# export GITHUB_USER="yourhandle"
# export GITLAB_USER="yourhandle"

# =======================================
# Secret Keys and Tokens
# =======================================

# Example API Keys
# export TWENTYFIRST_API_KEY="<CHANGE_ME>"
# export MORPH_API_KEY="<CHANGE_ME>"
# export TAVILY_API_KEY="<CHANGE_ME>"

# OpenCode providers (loaded via {env:...} in ~/.opencode/opencode.jsonc)
# Kimi / Moonshot AI
# export MOONSHOT_API_KEY="<CHANGE_ME>"
#
# MiniMax (minimax.io Token Plan or API Console)
# export MINIMAX_API_KEY="<CHANGE_ME>"
#
# Z.AI / GLM Coding Plan (models.dev provider id: zai / zai-coding-plan)
# export ZHIPU_API_KEY="<CHANGE_ME>"
#
# OpenCode Zen + OpenCode Go (same key space)
# export OPENCODE_API_KEY="<CHANGE_ME>"
#
# Optional extras used by other agents/tools (Aider, Hermes, skills CLI, …)
# export ANTHROPIC_API_KEY="<CHANGE_ME>"
# export OPENAI_API_KEY="<CHANGE_ME>"
# export GEMINI_API_KEY="<CHANGE_ME>"
# export OPENROUTER_API_KEY="<CHANGE_ME>"
# Aider also reads provider keys from the environment / a repo `.env`
#
# Hermes Agent (brew install hermes-agent; topic: hermes/)
# Prefer `hermes model` / `hermes setup` for provider config; keys above are shared.
# export HERMES_HOME="$HOME/.hermes"

# ========================================
# NOTE: Best Practices for Managing Secrets
# ========================================
#
# 1. Remember to keep this file secure with proper permissions:
#    chmod 600 ~/.localrc
#
# 2. Never commit this file to version control
#
# 3. Consider using a password manager (like Bitwarden) to store
#    these secrets securely and generate strong passwords
#
# 4. Rotate your secrets regularly
#
# 5. Use different credentials for development and production
#
# 6. Some services provide scoped tokens - use the minimum required permissions
#
# 7. Git name/email for commits belong in git/gitconfig.local.symlink
#    (created by bootstrap). The GIT_* exports above are optional extras.
