#!/usr/bin/env bash
#
# Render the managed OpenCode profile payloads.
#
# OCX has no profile inheritance: nothing above a profile layers into its
# ocx.jsonc or opencode.jsonc, so every shared key has to be physically present
# in every profile. The layering therefore happens here, before the payload
# reaches ~/.config/opencode. profiles/_shared holds the policy each profile
# shares, profiles/_routing.tsv holds the only thing that differs, and this
# script composes the two into the directories opencode/install.sh links.

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
  cat >&2 <<'EOF'
Usage: render-opencode-profiles [--check] [topic-directory]

  --check  Report stale payloads and exit 1 instead of writing them

The topic directory defaults to the opencode topic beside this script.
EOF
}

check_only=false
topic_dir=$SCRIPT_DIR/../opencode

while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)
      check_only=true
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      printf 'render-opencode-profiles: unknown option: %s\n' "$1" >&2
      usage
      exit 2
      ;;
    *)
      topic_dir=$1
      ;;
  esac
  shift
done

fail() {
  printf 'render-opencode-profiles: %s\n' "$1" >&2
  exit 1
}

# shellcheck source=_scripts/catalog.sh
# shellcheck disable=SC1091
. "$SCRIPT_DIR/catalog.sh"

# shellcheck source=_scripts/markdown-table.sh
# shellcheck disable=SC1091
. "$SCRIPT_DIR/markdown-table.sh"

# shellcheck source=_scripts/generated-file.sh
# shellcheck disable=SC1091
. "$SCRIPT_DIR/generated-file.sh"

topic_dir=$(CDPATH='' cd -P -- "$topic_dir" 2>/dev/null && pwd) \
  || fail "topic directory not found: $topic_dir"

roster=$topic_dir/_managed-entries.tsv
shared_dir=$topic_dir/profiles/_shared
routing=$topic_dir/profiles/_routing.tsv

for required in "$roster" "$routing" "$shared_dir/AGENTS.md" \
  "$shared_dir/ocx.jsonc" "$shared_dir/opencode.jsonc"; do
  [ -r "$required" ] || fail "required source not readable: $required"
done

# Roster order is apply order in the installer, and rendering in the same order
# keeps a diff of this script's output readable against one of the installer's.
mapfile -t profiles < <(
  awk -F'\t' '$1 == "profile" { print $2 }' "$roster"
)
[ "${#profiles[@]}" -gt 0 ] || fail "no profile rows in $roster"

declare -A routing_seen=()
# The routing table is read once, by the reader, during validation. These hold
# what the README needs afterwards so nothing rescans the file: composing the
# table used to fork one awk per role per profile, and the column positions were
# restated in each of those scans in a different index base from the jq pass.
declare -A routing_cell_of=()
declare -A routing_roles_of=()

mapfile -t roles < <(jq -r '.agent | keys_unsorted[]' "$shared_dir/opencode.jsonc")
[ "${#roles[@]}" -gt 0 ] \
  || fail "no agents declared in $shared_dir/opencode.jsonc"

# The routing table and the shared base are two halves of one declaration, so
# they are checked against each other before anything is rendered. Both
# directions matter: an unknown row is a typo, and a missing one would silently
# render a profile that routes an agent nowhere.
# One routing row, checked against the roster and the shared base. The reader
# delivers the row already split and padded, so this states the rules and
# nothing about tabs, comments, or column counts.
validate_routing_row() {
  local profile=$1 role=$2 model=$3
  local variant=$4 temperature=$5 effort=$6 verbosity=$7

  printf '%s\n' "${profiles[@]}" | grep -Fqx -- "$profile" \
    || fail "routing row names a profile with no roster entry: $profile"
  printf '%s\n' default small "${roles[@]}" | grep -Fqx -- "$role" \
    || fail "routing row names an undeclared agent: $profile $role"
  [ -z "${routing_seen["$profile/$role"]:-}" ] \
    || fail "duplicate routing row: $profile $role"
  routing_seen["$profile/$role"]=1

  [ -n "$model" ] && [ "$model" != - ] \
    || fail "routing row declares no model: $profile $role"

  case $role in
    default | small)
      [ "$variant$temperature$effort$verbosity" = '----' ] \
        || fail "$profile $role takes a model only, not model options"
      ;;
  esac

  case $temperature in
    - | [0-9] | [0-9].[0-9]*) ;;
    *) fail "$profile $role has a non-numeric temperature: $temperature" ;;
  esac

  routing_cell_of["$profile/$role"]=$(compose_routing_cell "$model" "$variant" "$effort")
  routing_roles_of["$profile"]+=$role$'\n'
}

# A role's cell is its model, plus the one knob that distinguishes it: the
# variant when the provider takes one, otherwise the reasoning effort. Every
# other column is a number the prose around this table does not discuss.
compose_routing_cell() {
  local model=$1 knob=$2 effort=$3

  [ "$knob" != - ] || knob=$effort
  [ "$knob" != - ] || knob=''

  # shellcheck disable=SC2016 # The backticks are Markdown code spans, not
  # command substitution: this composes a README table cell.
  if [ -n "$knob" ]; then
    printf '`%s` (`%s`)\n' "$model" "$knob"
  else
    printf '`%s`\n' "$model"
  fi
}

validate_routing() {
  local declared expected_roles missing profile

  expected_roles=$(printf '%s\n' default small "${roles[@]}" | sort)

  routing_seen=()
  routing_cell_of=()
  routing_roles_of=()
  catalog_each_row "$routing" validate_routing_row

  # Extra and misspelled rows are already refused above, so what is left to
  # check is a role the shared base declares and this profile never routes.
  for profile in "${profiles[@]}"; do
    declared=$(printf '%s' "${routing_roles_of["$profile"]:-}" | sort)
    missing=$(
      comm -13 <(printf '%s\n' "$declared") <(printf '%s\n' "$expected_roles") \
        | tr '\n' ' '
    )
    [ -z "$missing" ] || fail "$profile has no routing row for: ${missing% }"
  done
}

# Roles read Default, Small, then the agents in the order the shared base
# declares them, which is the order a person meets them in opencode.jsonc.
emit_routing_rows() {
  local role label profile row

  for role in default small "${roles[@]}"; do
    case $role in
      default) label=Default ;;
      small) label=Small ;;
      *) label=$(printf '%s' "${role:0:1}" | tr '[:lower:]' '[:upper:]')${role:1} ;;
    esac

    row=$label
    for profile in "${profiles[@]}"; do
      row=$row$'\t'${routing_cell_of["$profile/$role"]:-}
    done
    printf '%s\n' "$row"
  done
}

render_readme_block() {
  local profile header

  case "$1" in
    profile-routing)
      header=Role
      for profile in "${profiles[@]}"; do
        header=$header$'\t'"\`$profile\`"
      done
      emit_routing_rows | markdown_table "$header"
      ;;
    *)
      fail "unknown generated block: $1"
      ;;
  esac
}

render_config() {
  local profile=$1

  jq --indent 2 --arg profile "$profile" --rawfile routing "$routing" '
    def routed($row; $index; $key):
      if $row[$index] == "-" then {} else {($key): $row[$index]} end;

    ($routing
     | split("\n")
     | map(select(length > 0 and (startswith("#") | not)) | split("\t"))
     | map(select(.[0] == $profile))
     | map({key: .[1], value: .})
     | from_entries) as $routes
    | {
        "$schema": .["$schema"],
        model: $routes["default"][2],
        small_model: $routes["small"][2]
      }
      + (del(.["$schema"])
         | .agent = (
             .agent
             | to_entries
             | map(
                 $routes[.key] as $row
                 | {
                     key: .key,
                     value: (
                       {model: $row[2]}
                       + routed($row; 3; "variant")
                       + (if $row[4] == "-" then {}
                          else {temperature: ($row[4] | tonumber)} end)
                       + routed($row; 5; "reasoningEffort")
                       + routed($row; 6; "textVerbosity")
                       + .value
                     )
                   }
               )
             | from_entries))
  ' "$shared_dir/opencode.jsonc"
}

# A payload is written only when it changes, so a no-op render leaves the
# checkout untouched and --check has nothing to report.
sync_payload() {
  generated_file_sync "$1" "$2" "${2#"$topic_dir/"}"
}

validate_routing

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/render-opencode-profiles.XXXXXX")
trap 'rm -rf -- "$work_dir"' EXIT

if [ "$check_only" = true ]; then
  generated_file_mode check
else
  generated_file_mode write
fi
for profile in "${profiles[@]}"; do
  render_config "$profile" >"$work_dir/opencode.jsonc"
  sync_payload "$work_dir/opencode.jsonc" \
    "$topic_dir/profiles/$profile/opencode.jsonc"
  sync_payload "$shared_dir/ocx.jsonc" "$topic_dir/profiles/$profile/ocx.jsonc"
  sync_payload "$shared_dir/AGENTS.md" "$topic_dir/profiles/$profile/AGENTS.md"
done

# The routing table in the topic README is the same declaration in the shape a
# person reads. It was maintained by hand beside the catalog that drives the
# payloads, with nothing holding the two together.
markdown_render_blocks "$topic_dir/README.md" render_readme_block \
  >"$work_dir/README.md" || fail "cannot render $topic_dir/README.md"
sync_payload "$work_dir/README.md" "$topic_dir/README.md"

generated_file_verdict 'OpenCode profile payloads are' \
  _scripts/render-opencode-profiles
