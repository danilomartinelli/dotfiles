#!/usr/bin/env bash
#
# Explicit mobile simulator provisioning. Checks are local and read-only; the
# install path is the only path that invokes vendor package or runtime tools.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: mobile-setup [--check] [ios|android|all]

  Provision the selected iOS Simulator runtime and Android Emulator.
  --check  Inspect local state only; never downloads, launches, or changes it.
  ios      Provision the latest iOS Simulator runtime compatible with Xcode.
  android  Provision Android API 36 and the Pixel_API36 emulator.
  all      Provision both targets (the default).
EOF
}

MOBILE_SETUP_DIR=$(CDPATH='' cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# The progress vocabulary every installer prints in. Mobile Provisioning used to
# hand-roll the same glyphs, which made it the fourth copy of a voice that
# exists once precisely so a change to it reaches everything.
# shellcheck source=_scripts/installer-output.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/installer-output.sh"

# The record both target adapters fill, and the only place one becomes output.
# It is sourced first because both adapters compose into it.
# shellcheck source=_scripts/mobile-setup-readiness.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-readiness.sh"
# shellcheck source=_scripts/mobile-setup-ios.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-ios.sh"
# shellcheck source=_scripts/mobile-setup-android.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-android.sh"

# The Mobile Targets, declared once. Adding a third used to mean editing the
# usage text, the source list, two dispatch tables and the argument parser;
# every one of those but the source list and the prose reads this now.
MOBILE_TARGETS=(ios android)

mobile_target_is_declared() {
  local candidate=$1 declared

  for declared in "${MOBILE_TARGETS[@]}"; do
    [ "$declared" != "$candidate" ] || return 0
  done
  return 1
}

# The operation and the target compose the adapter's name rather than naming
# every pair. A composed name that resolves to nothing is the hazard that comes
# with that, so it is refused here: a half-added target must fail loudly rather
# than succeed by doing nothing. See CODING_STANDARDS.md.
dispatch_target() {
  local operation=$1
  local target=$2

  if ! command -v "${operation}_${target}" >/dev/null 2>&1; then
    installer_error "unsupported dispatch: $operation $target"
    return 2
  fi
  "${operation}_${target}"
}

dispatch_targets() {
  local operation=$1
  local target=$2
  local status=0
  local selected_target

  if [ "$target" = all ]; then
    for selected_target in "${MOBILE_TARGETS[@]}"; do
      dispatch_target "$operation" "$selected_target" || status=1
    done
  else
    dispatch_target "$operation" "$target" || status=1
  fi

  return "$status"
}

check_only=false
target=all
target_seen=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)
      if [ "$check_only" = true ]; then
        usage >&2
        exit 2
      fi
      check_only=true
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      if [ "$1" != all ] && ! mobile_target_is_declared "$1"; then
        installer_error "unknown argument: $1"
        usage >&2
        exit 2
      fi
      if [ "$target_seen" = true ]; then
        usage >&2
        exit 2
      fi
      target=$1
      target_seen=true
      ;;
  esac
  shift
done

if [ "$check_only" = true ]; then
  dispatch_targets check "$target"
else
  dispatch_targets install "$target"
fi
