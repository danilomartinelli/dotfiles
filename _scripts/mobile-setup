#!/usr/bin/env bash
#
# Explicit mobile simulator provisioning. Checks are local and read-only; the
# install path is the only path that invokes vendor package or runtime tools.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: mobile-setup [--check] [ios|android|all]

  Provision the selected iOS Simulator runtime and Android Emulator.
  --check  Inspect local state only; never downloads, launches, or changes it.
  ios      Provision the latest iOS Simulator runtime compatible with Xcode.
  android  Provision Android API 36 and the Pixel_API36 emulator.
  all      Provision both targets (the default).
EOF
}

MOBILE_SETUP_DIR=$(CDPATH='' cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# The record both target adapters fill, and the only place one becomes output.
# It is sourced first because both adapters compose into it.
# shellcheck source=_scripts/mobile-setup-readiness.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-readiness.sh"
# shellcheck source=_scripts/mobile-setup-ios.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-ios.sh"
# shellcheck source=_scripts/mobile-setup-android.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-android.sh"

dispatch_target() {
  local operation=$1
  local target=$2

  case "$operation:$target" in
    check:ios) check_ios ;;
    check:android) check_android ;;
    install:ios) install_ios ;;
    install:android) install_android ;;
    *)
      printf 'mobile-setup: unsupported dispatch: %s %s\n' "$operation" "$target" >&2
      return 2
      ;;
  esac
}

dispatch_targets() {
  local operation=$1
  local target=$2
  local status=0
  local selected_target

  case "$target" in
    ios | android)
      dispatch_target "$operation" "$target" || status=1
      ;;
    all)
      for selected_target in ios android; do
        dispatch_target "$operation" "$selected_target" || status=1
      done
      ;;
  esac

  return "$status"
}

check_only=false
target=all
target_seen=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)
      if [ "$check_only" = true ]; then
        usage >&2
        exit 2
      fi
      check_only=true
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    ios | android | all)
      if [ "$target_seen" = true ]; then
        usage >&2
        exit 2
      fi
      target=$1
      target_seen=true
      ;;
    *)
      printf 'mobile-setup: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ "$check_only" = true ]; then
  dispatch_targets check "$target"
else
  dispatch_targets install "$target"
fi
