#!/usr/bin/env bash
#
# Explicit mobile simulator provisioning. Checks are local and read-only; the
# install path is the only path that invokes vendor package or runtime tools.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: mobile-setup [--check] [ios|android|all]

  Provision the selected iOS Simulator runtime and Android Emulator.
  --check  Inspect local state only; never downloads, launches, or changes it.
  ios      Provision the latest iOS Simulator runtime compatible with Xcode.
  android  Provision Android API 36 and the Pixel_API36 emulator.
  all      Provision both targets (the default).
EOF
}

print_next_step() {
  printf '  Next step: %s\n' "$1"
}

MOBILE_SETUP_DIR=$(CDPATH='' cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# shellcheck source=_scripts/mobile-setup-ios.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-ios.sh"
# shellcheck source=_scripts/mobile-setup-android.sh
# shellcheck disable=SC1091
. "$MOBILE_SETUP_DIR/mobile-setup-android.sh"

check_targets() {
  local target=$1
  local status=0

  case "$target" in
    ios)
      check_ios || status=1
      ;;
    android)
      check_android || status=1
      ;;
    all)
      check_ios || status=1
      check_android || status=1
      ;;
  esac
  return "$status"
}

install_targets() {
  local target=$1
  local status=0

  case "$target" in
    ios)
      install_ios || status=1
      ;;
    android)
      install_android || status=1
      ;;
    all)
      install_ios || status=1
      install_android || status=1
      ;;
  esac
  return "$status"
}

check_only=false
target=all
target_seen=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --check)
      if [ "$check_only" = true ]; then
        usage >&2
        exit 2
      fi
      check_only=true
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    ios | android | all)
      if [ "$target_seen" = true ]; then
        usage >&2
        exit 2
      fi
      target=$1
      target_seen=true
      ;;
    *)
      printf 'mobile-setup: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ "$check_only" = true ]; then
  check_targets "$target"
else
  install_targets "$target"
fi
