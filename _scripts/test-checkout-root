#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
TEST_ROOT=$(CDPATH='' cd -P -- "$SCRIPT_DIR/.." && pwd)
RESOLVER="$TEST_ROOT/dotfiles-root.symlink"
# shellcheck source=tests/_support/shell-scenario.sh
source "$TEST_ROOT/tests/_support/shell-scenario.sh"
scenario_init dotfiles-root-test

test_anchor_resolution() {
  local case_root
  case_root=$(scenario_tmpdir anchors)

  assert_equal "$TEST_ROOT" "$("$RESOLVER" "$TEST_ROOT/bin/dot")" "absolute anchor"
  assert_equal "$TEST_ROOT" "$(cd "$TEST_ROOT" && "$RESOLVER" bin/dot)" "relative anchor"
  assert_equal "$TEST_ROOT" "$(cd "$case_root" && PATH="$TEST_ROOT/bin:$PATH" "$RESOLVER" dot)" "command-name anchor"
  # shellcheck disable=SC2016 # The Git alias must retain the variable for runtime expansion.
  assert_equal '!"$DOTFILES_ROOT/bin/git-promote"' "$(git config --file "$TEST_ROOT/git/gitconfig.symlink" --get alias.promote)" "Git alias root variable"

  mkdir -p "$case_root/links"
  ln -s "$TEST_ROOT/bin/dot" "$case_root/links/absolute"
  ln -s absolute "$case_root/links/relative"
  assert_equal "$TEST_ROOT" "$("$RESOLVER" "$case_root/links/relative")" "relative symlink chain"
}

test_invalid_anchors() {
  local case_root
  case_root=$(scenario_tmpdir invalid-anchors)

  mkdir -p "$case_root/links"
  ln -s missing "$case_root/links/broken"
  assert_fails_with_output "broken symlink" "broken or missing anchor" "$RESOLVER" "$case_root/links/broken"
  ln -s cycle-b "$case_root/links/cycle-a"
  ln -s cycle-a "$case_root/links/cycle-b"
  assert_fails_with_output "symlink cycle" "symlink cycle" "$RESOLVER" "$case_root/links/cycle-a"

  touch "$case_root/outside"
  assert_fails_with_output "anchor outside a checkout" "not inside a dotfiles checkout" "$RESOLVER" "$case_root/outside"
}

test_checkout_types() {
  local case_root
  case_root=$(scenario_tmpdir checkout-types)

  mkdir -p "$case_root/archive/nested"
  cp "$RESOLVER" "$case_root/archive/dotfiles-root.symlink"
  touch "$case_root/archive/nested/anchor"
  assert_equal "$case_root/archive" "$("$RESOLVER" "$case_root/archive/nested/anchor")" "non-Git checkout"

  mkdir -p "$case_root/repository/nested"
  cp "$RESOLVER" "$case_root/repository/dotfiles-root.symlink"
  touch "$case_root/repository/nested/anchor"
  git -C "$case_root/repository" init -q
  git -C "$case_root/repository" config user.name 'Dotfiles Root Test'
  git -C "$case_root/repository" config user.email 'dotfiles-root@example.invalid'
  git -C "$case_root/repository" add .
  git -C "$case_root/repository" commit -qm 'test fixture'
  assert_equal "$case_root/repository" "$("$RESOLVER" "$case_root/repository/nested/anchor")" "ordinary Git checkout"
  git -C "$case_root/repository" worktree add -q --detach "$case_root/worktree"
  [ -f "$case_root/worktree/.git" ] || scenario_fail "worktree fixture does not have a .git file"
  assert_equal "$case_root/worktree" "$("$RESOLVER" "$case_root/worktree/nested/anchor")" "Git worktree"
}

test_home_link_installation() {
  local case_root
  local test_home
  case_root=$(scenario_tmpdir home-link)
  test_home="$case_root/home"
  mkdir -p "$case_root/archive" "$test_home"
  cp "$RESOLVER" "$case_root/archive/dotfiles-root.symlink"

  assert_equal "$TEST_ROOT" "$(HOME="$test_home" "$RESOLVER" --install "$TEST_ROOT/bin/dot")" "initial install"
  assert_equal "$TEST_ROOT/dotfiles-root.symlink" "$(readlink "$test_home/.dotfiles-root")" "installed target"
  assert_equal "$TEST_ROOT" "$(HOME="$test_home" "$test_home/.dotfiles-root")" "installed default anchor"
  assert_equal "$TEST_ROOT" "$(HOME="$test_home" "$RESOLVER" --install "$TEST_ROOT/bin/dot")" "idempotent install"

  rm "$test_home/.dotfiles-root"
  ln -s "$case_root/archive/dotfiles-root.symlink" "$test_home/.dotfiles-root"
  HOME="$test_home" "$RESOLVER" --install "$TEST_ROOT/bin/dot" >/dev/null
  assert_equal "$TEST_ROOT/dotfiles-root.symlink" "$(readlink "$test_home/.dotfiles-root")" "stale link update"

  rm "$test_home/.dotfiles-root"
  ln -s missing "$test_home/.dotfiles-root"
  HOME="$test_home" "$RESOLVER" --install "$TEST_ROOT/bin/dot" >/dev/null
  assert_equal "$TEST_ROOT/dotfiles-root.symlink" "$(readlink "$test_home/.dotfiles-root")" "broken link update"

  rm "$test_home/.dotfiles-root"
  touch "$test_home/.dotfiles-root"
  assert_fails "regular-file protection" env HOME="$test_home" "$RESOLVER" --install "$TEST_ROOT/bin/dot"
  rm "$test_home/.dotfiles-root"
  mkdir "$test_home/.dotfiles-root"
  assert_fails "directory protection" env HOME="$test_home" "$RESOLVER" --install "$TEST_ROOT/bin/dot"
}

test_adapter_checkout_preamble() {
  local case_root
  local test_home
  local resolved

  case_root=$(scenario_tmpdir adapter-checkout)
  test_home="$case_root/home"
  mkdir -p "$test_home" "$case_root/bin"
  cp "$TEST_ROOT/bin/dot" "$case_root/bin/dot"
  mkdir -p "$case_root/_scripts"
  cp "$TEST_ROOT/_scripts/adapter-checkout.sh" "$case_root/_scripts/adapter-checkout.sh"
  cp "$TEST_ROOT/dotfiles-root.symlink" "$case_root/dotfiles-root.symlink"
  chmod +x "$case_root/bin/dot" "$case_root/dotfiles-root.symlink"

  # Without ~/.dotfiles-root, fall back to the sibling resolver.
  # shellcheck disable=SC1091
  resolved=$(
    HOME="$test_home" \
      ADAPTER_ANCHOR="$case_root/bin/dot" \
      sh -c '. "$1" && printf %s "$DOTFILES_ROOT"' \
      sh "$case_root/_scripts/adapter-checkout.sh"
  )
  assert_equal "$case_root" "$resolved" 'sibling resolver fallback'

  ln -s "$TEST_ROOT/dotfiles-root.symlink" "$test_home/.dotfiles-root"
  resolved=$(
    HOME="$test_home" \
      ADAPTER_ANCHOR="$case_root/bin/dot" \
      sh -c '. "$1" && printf %s "$DOTFILES_ROOT"' \
      sh "$case_root/_scripts/adapter-checkout.sh"
  )
  # Anchor keeps the invoking checkout even when ~/.dotfiles-root points elsewhere.
  assert_equal "$case_root" "$resolved" 'home resolver with local anchor'

  rm "$test_home/.dotfiles-root"
  ln -s missing "$test_home/.dotfiles-root"
  resolved=$(
    HOME="$test_home" \
      ADAPTER_ANCHOR="$case_root/bin/dot" \
      sh -c '. "$1" && printf %s "$DOTFILES_ROOT"' \
      sh "$case_root/_scripts/adapter-checkout.sh"
  )
  assert_equal "$case_root" "$resolved" 'broken home link falls back'
}

test_adapter_integration() {
  local case_root
  local test_home
  case_root=$(scenario_tmpdir adapters)
  test_home="$case_root/home"
  mkdir -p "$test_home"

  ln -s "$TEST_ROOT/dotfiles-root.symlink" "$test_home/.dotfiles-root"
  ln -s "$TEST_ROOT/zsh/zshrc.symlink" "$test_home/.zshrc"
  # shellcheck disable=SC2016 # The script is evaluated by the child Zsh process.
  if ! scenario_capture "$case_root/zsh" env -u ZSH HOME="$test_home" EXPECTED_ROOT="$TEST_ROOT" zsh -d -f -c '
    source "$HOME/.zshrc"
    [[ "$DOTFILES_ROOT" == "$EXPECTED_ROOT" ]]
    [[ -z "${ZSH+x}" ]]
  '; then
    command cat "$case_root/zsh/stderr.log" >&2
    scenario_fail "Zsh startup did not export only DOTFILES_ROOT"
  fi

  scenario_write_executable "$case_root/editor" <<'EOF'
#!/bin/sh
printf '%s\n' "$1" > "$EDITOR_CAPTURE"
EOF
  scenario_capture "$case_root/edit" env \
    HOME="$test_home" \
    EDITOR="$case_root/editor" \
    EDITOR_CAPTURE="$case_root/editor-argument" \
    "$TEST_ROOT/bin/dot" --edit
  assert_equal "$TEST_ROOT" "$(command cat "$case_root/editor-argument")" "dot --edit checkout"
}

scenario_run 'anchors resolve from paths, commands, and symlink chains' test_anchor_resolution
scenario_run 'invalid anchors fail with explicit diagnostics' test_invalid_anchors
scenario_run 'marker directories, Git checkouts, and worktrees resolve locally' test_checkout_types
scenario_run 'the stable home link installs, repairs, and protects conflicts' test_home_link_installation
scenario_run 'adapter-checkout prefers home link and falls back to sibling' test_adapter_checkout_preamble
scenario_run 'Zsh and dot --edit use the checkout-root adapter' test_adapter_integration
scenario_finish
