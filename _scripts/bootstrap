#!/usr/bin/env bash
#
# First-run adapter for the canonical setup module.

set -e

BOOTSTRAP_PATH=${BASH_SOURCE[0]}
ROOT_RESOLVER=$HOME/.dotfiles-root
if [ ! -L "$ROOT_RESOLVER" ] || [ ! -x "$ROOT_RESOLVER" ]; then
  SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$BOOTSTRAP_PATH")" && pwd)
  ROOT_RESOLVER=$SCRIPT_DIR/../dotfiles-root.symlink
fi

DOTFILES_ROOT=$("$ROOT_RESOLVER" "$BOOTSTRAP_PATH")
export DOTFILES_ROOT

exec "$DOTFILES_ROOT/_scripts/setup" bootstrap
