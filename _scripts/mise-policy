#!/bin/sh
# Run Mise against a caller-selected checkout; never resolve a checkout here.
# Usage: mise-policy <checkout> [--declarations <directory>] run <command> [args...]
#        mise-policy <checkout> [--declarations <directory>] lock [--bump] <tools...>
#        mise-policy <checkout> {shell|completion|ci|local|trust}

set -eu

fail() {
  printf 'mise-policy: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'Usage: mise-policy <checkout> [--declarations <directory>] {run <command> [args...] | lock [--bump] <tools...> | shell | completion | ci | local | trust}\n' >&2
  exit 2
}

[ "$#" -ge 2 ] || usage
checkout=$1
shift
case "$checkout" in
  /*) ;;
  *) usage ;;
esac
declarations=$checkout/mise
if [ "$1" = --declarations ]; then
  [ "$#" -ge 3 ] || usage
  declarations=$2
  shift 2
fi
operation=$1
shift
locked=true
case "$operation" in
  run)
    [ "$#" -gt 0 ] || usage
    case "$1" in
      install | exec | where | ls | outdated | prune) ;;
      *) usage ;;
    esac
    ;;
  lock)
    selection=false
    for tool in "$@"; do
      case "$tool" in
        --bump) ;;
        -* | '') usage ;;
        *) selection=true ;;
      esac
    done
    [ "$selection" = true ] || usage
    locked=false
    set -- lock --global "$@"
    ;;
  shell | completion | ci | local | trust)
    [ "$#" -eq 0 ] || usage
    [ "$declarations" = "$checkout/mise" ] || usage
    ;;
  *) usage ;;
esac

if [ "$operation" = local ]; then
  cat <<'EOF'
# Generated by _scripts/mise-policy. Keep local policy out of global settings.
[settings]
lockfile = true
locked = true
EOF
  exit 0
fi

# Paths become path lists and (for CI) line-oriented environment assignments.
# Refuse unrepresentable input before emitting anything or invoking Mise.
newline='
'
for directory in "$checkout" "$declarations" "$HOME" "${WORKSPACE:-$HOME/Workspace}"; do
  case "$directory" in
    *":"* | *"$newline"*) fail 'paths must not contain colons or newlines' ;;
    /*) ;;
    *) fail "expected an absolute path: $directory" ;;
  esac
done
roots=$("$checkout/_scripts/trusted-roots") || fail 'cannot prepare trusted roots'
[ -n "$roots" ] || fail 'trusted roots are empty'
trust=$(printf '%s\n' "$roots" | paste -sd ':' -)
if [ "$declarations" != "$checkout/mise" ]; then
  trust=$trust:$declarations
fi

if [ "$operation" = trust ]; then
  printf '# Rendered by _scripts/mise-policy from _scripts/trusted-roots.\n\n'
  printf '[settings]\ntrusted_config_paths = [\n'
  printf '%s\n' "$roots" | while IFS= read -r root; do
    escaped=$(printf '%s' "$root" | sed 's/[\\"]/\\&/g')
    printf '  "%s",\n' "$escaped"
  done
  printf ']\n'
  exit 0
fi

if [ "$operation" = shell ] || [ "$operation" = completion ]; then
  legacy_global=false
  if [ "${MISE_GLOBAL_CONFIG_FILE-}" = "$HOME/.config/mise/config.toml" ]; then
    unset MISE_GLOBAL_CONFIG_FILE
    legacy_global=true
  fi
  export MISE_TRUSTED_CONFIG_PATHS="$trust"
  if [ "$operation" = completion ]; then
    mise completion zsh || fail 'completion failed'
    exit 0
  fi
  activation=$(mise activate zsh) || fail 'activation failed; shell integration skipped'
  # Emit only after preparation and activation both succeed. The shell applies
  # this complete payload; a failed child cannot partially change its parent.
  [ "$legacy_global" = false ] || printf 'unset MISE_GLOBAL_CONFIG_FILE\n'
  escaped_trust=$(printf '%s' "$trust" | sed "s/'/'\\\\''/g")
  printf "export MISE_TRUSTED_CONFIG_PATHS='%s'\n%s\n" "$escaped_trust" "$activation"
  exit 0
fi

[ -f "$declarations/config.toml" ] || fail "missing declarations: $declarations/config.toml"
if [ "$operation" != lock ]; then
  [ -f "$declarations/mise.lock" ] || fail "missing lock: $declarations/mise.lock; regenerate selected tools before reconciliation"
fi

# Only the selected configuration participates. Absolute discovery patterns
# suppress project/ancestor config; the non-directory disables optional system
# and legacy files without creating anything in the checkout or home.
settings=$(
  cat <<EOF
MISE_CONFIG_DIR=/dev/null
MISE_GLOBAL_CONFIG_FILE=$declarations/config.toml
MISE_OVERRIDE_CONFIG_FILENAMES=/dev/null/config.toml
MISE_OVERRIDE_TOOL_VERSIONS_FILENAMES=/dev/null/.tool-versions
MISE_SYSTEM_CONFIG_DIR=/dev/null
MISE_SYSTEM_CONFIG_FILE=/dev/null/config.toml
MISE_CEILING_PATHS=$checkout
MISE_ENV=
MISE_AUTO_ENV=false
MISE_ENV_FILE=
MISE_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS=
MISE_TRUSTED_CONFIG_PATHS=$trust
MISE_LOCKFILE=true
MISE_LOCKED=$locked
MISE_LOCKED_SCOPES=global,project,system
MISE_NO_CONFIG=false
EOF
)

# Version selectors must not override the checkout's declarations. These are
# variable names only; neither inherited values nor other environment is logged.
for selector in $(env | sed -n 's/^\(MISE_[A-Za-z0-9_]*_VERSION\)=.*/\1/p'); do
  if [ "$operation" = ci ]; then
    # GITHUB_ENV cannot unset inherited variables; Mise ignores empty selectors.
    printf '%s=\n' "$selector"
  else
    unset "$selector"
  fi
done
if [ "$operation" = ci ]; then
  printf '%s\n' "$settings"
  exit 0
fi
while IFS= read -r setting; do
  export "${setting?}"
done <<EOF
$settings
EOF
cd "$checkout"
exec mise "$@"
