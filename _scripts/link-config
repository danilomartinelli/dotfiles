#!/bin/sh
#
# Idempotent config linking for topic installers.
# Default policy: replace-with-backup.

set -eu

# The linker prints under the banner of whichever installer called it, so it
# uses that vocabulary rather than a third copy of the glyphs. Resolved from
# $0 because this file is always <checkout>/_scripts/link-config.
# shellcheck source=_scripts/installer-output.sh
# shellcheck disable=SC1091
. "$(CDPATH='' cd -P -- "${0%/*}" && pwd)/installer-output.sh"

usage() {
  cat >&2 <<'EOF'
Usage: link-config [--policy POLICY] [--label LABEL] <source> <target>
       link-config --status <source> <target>

Options:
  --status  Print what the target is — current, conflict, or absent — and
            exit without changing anything.

Exit status:
  0  the target now matches the declaration, or the policy kept it deliberately
  1  the link could not be made
  2  invalid usage, or a removal the linker refuses to perform

Policies:
  replace-with-backup  Default. Back up an existing real target once, then link.
                       Fails when that one backup slot is already taken.
  preserve-existing    Keep an existing target and change nothing.
  numbered-backup      Move an existing target to the next free .backup suffix.
  replace-generated    Caller asserts the target is regenerated by its own tool:
                       remove it without a backup, then link.
  replace-confirmed    Caller asserts an operator confirmed this target:
                       remove it without a backup, then link.
EOF
}

policy=replace-with-backup
label=
status_only=false
source_path=
target_path=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --policy)
      [ "$#" -ge 2 ] || {
        usage
        exit 2
      }
      policy=$2
      shift 2
      ;;
    --label)
      [ "$#" -ge 2 ] || {
        usage
        exit 2
      }
      label=$2
      shift 2
      ;;
    --status)
      status_only=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "link-config: unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -ne 2 ]; then
  usage
  exit 2
fi

source_path=$1
target_path=$2

case "$policy" in
  replace-with-backup | preserve-existing | numbered-backup | replace-generated | \
    replace-confirmed) ;;
  *)
    echo "link-config: unknown policy: $policy" >&2
    exit 2
    ;;
esac

if [ -z "$label" ]; then
  label=$(basename -- "$target_path")
fi

if [ ! -e "$source_path" ] && [ ! -L "$source_path" ]; then
  echo "link-config: source not found: $source_path" >&2
  exit 1
fi

canonical_file_path() {
  canonical_input=$1
  canonical_directory=$(CDPATH='' cd -P -- "$(dirname -- "$canonical_input")" 2>/dev/null && pwd) || return 1
  printf '%s/%s\n' "$canonical_directory" "$(basename -- "$canonical_input")"
}

resolve_existing_path() {
  if [ -d "$1" ]; then
    CDPATH='' cd -P -- "$1" 2>/dev/null && pwd
  else
    canonical_file_path "$1"
  fi
}

# The two policies that destroy without a backup — replace-generated and
# replace-confirmed — share this guard, because the targets whose removal is
# never what a caller meant do not depend on why the caller asked: the
# filesystem root, the home directory, and any directory holding the source
# about to be linked. The last rule keeps a checkout from deleting itself
# without teaching this script where checkouts live. Symbolic links need no
# guard: rm removes the link, not what it points at.
refuse_unsafe_generated_target() {
  guard_target=$(resolve_existing_path "$target_path") || {
    echo "link-config: cannot resolve $target_path; refusing to replace it" >&2
    exit 2
  }

  guard_home=${HOME:-}
  if [ -n "$guard_home" ] && [ -d "$guard_home" ]; then
    guard_home=$(CDPATH='' cd -P -- "$guard_home" 2>/dev/null && pwd) || guard_home=
  fi

  # A resolved target is always a non-empty absolute path, so an unset or
  # unresolvable HOME simply never matches.
  if [ "$guard_target" = / ] || [ "$guard_target" = "$guard_home" ]; then
    echo "link-config: refusing to remove $guard_target under replace-generated" >&2
    exit 2
  fi

  guard_source=$(resolve_existing_path "$source_path") || {
    echo "link-config: cannot resolve $source_path; refusing to replace $guard_target" >&2
    exit 2
  }

  case "$guard_source" in
    "$guard_target"/*)
      echo "link-config: refusing to remove $guard_target; it contains the source $guard_source" >&2
      exit 2
      ;;
  esac
}

next_backup_path() {
  backup_base=$1.backup
  backup_path=$backup_base
  backup_number=1

  while [ -e "$backup_path" ] || [ -L "$backup_path" ]; do
    backup_path=$backup_base.$backup_number
    backup_number=$((backup_number + 1))
  done

  printf '%s\n' "$backup_path"
}

link_is_current() {
  [ -L "$target_path" ] || return 1

  current_target=$(readlink "$target_path") || return 1
  case "$current_target" in
    /*) ;;
    *) current_target=$(dirname -- "$target_path")/$current_target ;;
  esac

  current_target=$(canonical_file_path "$current_target") || return 1
  expected_target=$(canonical_file_path "$source_path") || return 1
  [ "$current_target" = "$expected_target" ]
}

# What a caller has to know before it can state an intent. Home linking derived
# this a second time, by different path arithmetic, and reported it in a second
# voice; the module that owns what happens to an existing target owns what that
# target is. Prints one word and changes nothing.
if [ "$status_only" = true ]; then
  if link_is_current; then
    echo current
  elif [ -e "$target_path" ] || [ -L "$target_path" ]; then
    echo conflict
  else
    echo absent
  fi
  exit 0
fi

if link_is_current; then
  installer_item "$label already linked"
  exit 0
fi

if [ -e "$target_path" ] || [ -L "$target_path" ]; then
  case "$policy" in
    preserve-existing)
      installer_note "Existing $target_path kept (not overwriting local config)"
      exit 0
      ;;
    replace-with-backup)
      if [ -e "$target_path" ] && [ ! -L "$target_path" ]; then
        backup=${target_path}.backup
        # The caller asked for a link and this is the one path that cannot
        # produce one: the single backup slot this policy owns is occupied, so
        # honouring the request would destroy the earlier backup. Reported as a
        # failure rather than a warning because exiting zero here told every
        # caller the link existed — see
        # docs/adr/0010-a-link-the-linker-could-not-make-is-a-failure.md.
        if [ -e "$backup" ] || [ -L "$backup" ]; then
          installer_error "$target_path and $backup exist; cannot link $label"
          installer_hint "Move or remove $backup, then rerun"
          exit 1
        fi
        mv "$target_path" "$backup"
        installer_note "Existing $label moved to $backup"
      else
        # Wrong symlink or other link target: replace in place.
        rm -f "$target_path"
      fi
      ;;
    replace-generated)
      if [ -e "$target_path" ] && [ ! -L "$target_path" ]; then
        refuse_unsafe_generated_target
      fi
      rm -rf "$target_path"
      installer_note "Replaced generated $label"
      ;;
    # A person chose this at a prompt, or a caller was run with an explicit
    # batch instruction. Same destruction, same guard, different reason — and
    # the reason is what the message has to say, because "generated" would be
    # a claim about a file the operator may well have written by hand.
    replace-confirmed)
      if [ -e "$target_path" ] && [ ! -L "$target_path" ]; then
        refuse_unsafe_generated_target
      fi
      rm -rf "$target_path"
      installer_note "Replaced $label as confirmed"
      ;;
    numbered-backup)
      backup=$(next_backup_path "$target_path")
      mv "$target_path" "$backup"
      installer_note "backed up $target_path to $backup"
      ;;
  esac
fi

ln -sfn "$source_path" "$target_path"
installer_item "$label linked"
