#!/bin/sh
#
# Idempotent config linking for topic installers.
# Default policy: replace-with-backup. Creates the directory that holds the
# destination when it is missing.

set -eu

# The linker prints under the banner of whichever installer called it, so it
# uses that vocabulary rather than a third copy of the glyphs. Resolved from
# $0 because this file is always <checkout>/_scripts/link-config.
# shellcheck source=_scripts/installer-output.sh
# shellcheck disable=SC1091
. "$(CDPATH='' cd -P -- "${0%/*}" && pwd)/installer-output.sh"

usage() {
  cat >&2 <<'EOF'
Usage: link-config [--policy POLICY] [--label LABEL] <source> <destination>
       link-config --status <source> <destination>

Options:
  --status  Print what the destination holds — current, conflict, or absent —
            and exit without changing anything.

Exit status:
  0  the destination now matches the declaration, or the policy kept it
     deliberately
  1  the link, or the directory that holds it, could not be made
  2  invalid usage, or a removal the linker refuses to perform

Policies:
  replace-with-backup  Default. Back up a real conflict once, then link.
                       Fails when that one backup slot is already taken.
  preserve-existing    Keep a conflict and change nothing.
  numbered-backup      Move a conflict to the next free .backup suffix.
  replace-confirmed    Caller asserts an operator confirmed this conflict:
                       remove it without a backup, then link.
EOF
}

policy=replace-with-backup
label=
status_only=false
source_path=
destination_path=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --policy)
      [ "$#" -ge 2 ] || {
        usage
        exit 2
      }
      policy=$2
      shift 2
      ;;
    --label)
      [ "$#" -ge 2 ] || {
        usage
        exit 2
      }
      label=$2
      shift 2
      ;;
    --status)
      status_only=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "link-config: unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -ne 2 ]; then
  usage
  exit 2
fi

source_path=$1
destination_path=$2

case "$policy" in
  replace-with-backup | preserve-existing | numbered-backup | replace-confirmed) ;;
  *)
    echo "link-config: unknown policy: $policy" >&2
    exit 2
    ;;
esac

if [ -z "$label" ]; then
  label=$(basename -- "$destination_path")
fi

if [ ! -e "$source_path" ] && [ ! -L "$source_path" ]; then
  echo "link-config: source not found: $source_path" >&2
  exit 1
fi

canonical_file_path() {
  canonical_input=$1
  canonical_directory=$(CDPATH='' cd -P -- "$(dirname -- "$canonical_input")" 2>/dev/null && pwd) || return 1
  printf '%s/%s\n' "$canonical_directory" "$(basename -- "$canonical_input")"
}

resolve_existing_path() {
  if [ -d "$1" ]; then
    CDPATH='' cd -P -- "$1" 2>/dev/null && pwd
  else
    canonical_file_path "$1"
  fi
}

# replace-confirmed destroys without a backup, so it refuses the destinations
# whose removal is never what a caller meant, whatever the operator confirmed:
# the filesystem root, the home directory, and any directory holding the source
# about to be linked. The last rule keeps a checkout from deleting itself
# without teaching this script where checkouts live. Symbolic links need no
# guard: rm removes the link, not what it points at.
refuse_unsafe_replacement() {
  guard_destination=$(resolve_existing_path "$destination_path") || {
    echo "link-config: cannot resolve $destination_path; refusing to replace it" >&2
    exit 2
  }

  guard_home=${HOME:-}
  if [ -n "$guard_home" ] && [ -d "$guard_home" ]; then
    guard_home=$(CDPATH='' cd -P -- "$guard_home" 2>/dev/null && pwd) || guard_home=
  fi

  # A resolved destination is always a non-empty absolute path, so an unset or
  # unresolvable HOME simply never matches.
  if [ "$guard_destination" = / ] || [ "$guard_destination" = "$guard_home" ]; then
    echo "link-config: refusing to remove $guard_destination under replace-confirmed" >&2
    exit 2
  fi

  guard_source=$(resolve_existing_path "$source_path") || {
    echo "link-config: cannot resolve $source_path; refusing to replace $guard_destination" >&2
    exit 2
  }

  case "$guard_source" in
    "$guard_destination"/*)
      echo "link-config: refusing to remove $guard_destination; it contains the source $guard_source" >&2
      exit 2
      ;;
  esac
}

next_backup_path() {
  backup_base=$1.backup
  backup_path=$backup_base
  backup_number=1

  while [ -e "$backup_path" ] || [ -L "$backup_path" ]; do
    backup_path=$backup_base.$backup_number
    backup_number=$((backup_number + 1))
  done

  printf '%s\n' "$backup_path"
}

link_is_current() {
  [ -L "$destination_path" ] || return 1

  current_source=$(readlink "$destination_path") || return 1
  case "$current_source" in
    /*) ;;
    *) current_source=$(dirname -- "$destination_path")/$current_source ;;
  esac

  current_source=$(canonical_file_path "$current_source") || return 1
  expected_source=$(canonical_file_path "$source_path") || return 1
  [ "$current_source" = "$expected_source" ]
}

# What a caller has to know before it can state an intent. Home linking derived
# this a second time, by different path arithmetic, and reported it in a second
# voice; the module that owns what happens to a conflict owns what a
# destination holds. Prints one word and changes nothing.
if [ "$status_only" = true ]; then
  if link_is_current; then
    echo current
  elif [ -e "$destination_path" ] || [ -L "$destination_path" ]; then
    echo conflict
  else
    echo absent
  fi
  exit 0
fi

if link_is_current; then
  installer_item "$label already linked"
  exit 0
fi

if [ -e "$destination_path" ] || [ -L "$destination_path" ]; then
  case "$policy" in
    preserve-existing)
      installer_note "Existing $destination_path kept (not overwriting local config)"
      exit 0
      ;;
    replace-with-backup)
      if [ -e "$destination_path" ] && [ ! -L "$destination_path" ]; then
        backup=${destination_path}.backup
        # The caller asked for a link and this is the one path that cannot
        # produce one: the single backup slot this policy owns is occupied, so
        # honouring the request would destroy the earlier backup. Reported as a
        # failure rather than a warning because exiting zero here told every
        # caller the link existed.
        if [ -e "$backup" ] || [ -L "$backup" ]; then
          installer_error "$destination_path and $backup exist; cannot link $label"
          installer_hint "Move or remove $backup, then rerun"
          exit 1
        fi
        mv "$destination_path" "$backup"
        installer_note "Existing $label moved to $backup"
      else
        # A link to somewhere else: replace it in place.
        rm -f "$destination_path"
      fi
      ;;
    # A person chose this at a prompt, or a caller was run with an explicit
    # batch instruction. The message says it was confirmed rather than making
    # any claim about who wrote a file the operator may well have written by
    # hand.
    replace-confirmed)
      if [ -e "$destination_path" ] && [ ! -L "$destination_path" ]; then
        refuse_unsafe_replacement
      fi
      rm -rf "$destination_path"
      installer_note "Replaced $label as confirmed"
      ;;
    numbered-backup)
      backup=$(next_backup_path "$destination_path")
      mv "$destination_path" "$backup"
      installer_note "backed up $destination_path to $backup"
      ;;
  esac
fi

# Every caller wants the link whether or not its directory exists yet, so the
# linker makes the directory rather than each installer spelling out a mkdir.
destination_directory=$(dirname -- "$destination_path")
mkdir -p -- "$destination_directory" || {
  installer_error "cannot create $destination_directory; cannot link $label"
  exit 1
}

ln -sfn "$source_path" "$destination_path"
installer_item "$label linked"
