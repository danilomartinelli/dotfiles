#!/usr/bin/env bash
#
# Bootstrap home linking for .localrc and topic *.symlink entries.

set -e
set -o pipefail

LINK_DOTFILES_PATH=${BASH_SOURCE[0]}
SCRIPT_DIR="$(CDPATH='' cd -P -- "$(dirname -- "$LINK_DOTFILES_PATH")" && pwd)"
ROOT_RESOLVER=$SCRIPT_DIR/../dotfiles-root.symlink
DOTFILES_ROOT=${DOTFILES_ROOT:-$("$ROOT_RESOLVER" "$LINK_DOTFILES_PATH")}
export DOTFILES_ROOT
TOPIC_CATALOG=$DOTFILES_ROOT/_scripts/topic-catalog
LINK_CONFIG=$DOTFILES_ROOT/_scripts/link-config

LINK_ACTION=''
overwrite_all=false
backup_all=false
skip_all=false
batch_mode=

usage() {
  cat >&2 <<'EOF'
Usage: link-dotfiles [--batch skip|overwrite|backup]

  Link .localrc and topic *.symlink entries into $HOME.
  Without --batch, prompts on conflicts (bootstrap).
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --batch)
      [ "$#" -ge 2 ] || {
        usage
        exit 2
      }
      batch_mode=$2
      case "$batch_mode" in
        skip | overwrite | backup) ;;
        *)
          usage
          exit 2
          ;;
      esac
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

# shellcheck source=_scripts/output.sh
# shellcheck disable=SC1091
. "$DOTFILES_ROOT/_scripts/output.sh"

choose_link_action() {
  local src
  local dst
  local action

  src=$1
  dst=$2

  while true; do
    prompt "File already exists: $dst ($(basename "$src")). [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
    read -r -n 1 action
    printf '\n'

    case "$action" in
      o)
        LINK_ACTION=overwrite
        return 0
        ;;
      O)
        overwrite_all=true
        LINK_ACTION=overwrite
        return 0
        ;;
      b)
        LINK_ACTION=backup
        return 0
        ;;
      B)
        backup_all=true
        LINK_ACTION=backup
        return 0
        ;;
      s)
        LINK_ACTION=skip
        return 0
        ;;
      S)
        skip_all=true
        LINK_ACTION=skip
        return 0
        ;;
      *) warn "Unknown choice: $action" ;;
    esac
  done
}

absolute_link_target() {
  local dst
  local target
  local target_dir
  local target_name

  dst=$1
  target=$2

  case "$target" in
    /*) printf '%s\n' "$target" ;;
    *)
      target_dir=$(dirname "$target")
      target_name=$(basename "$target")
      if cd "$(dirname "$dst")/$target_dir" 2>/dev/null; then
        printf '%s/%s\n' "$(pwd -P)" "$target_name"
      else
        printf '%s\n' "$target"
      fi
      ;;
  esac
}

# This module decides *which* action a conflict gets — from a batch flag, a
# remembered all-answer, or the prompt. The config linker performs it. Every
# removal belongs to the linker, which is what ADR 0001 settled for installers
# and what this caller now honours too: the linker refuses to clobber an
# existing backup and guards the paths an unattended rm -rf must never take.
link_action_policy() {
  case "$1" in
    overwrite) printf '%s\n' replace-confirmed ;;
    backup) printf '%s\n' replace-with-backup ;;
    skip) printf '%s\n' preserve-existing ;;
    *) return 1 ;;
  esac
}

link_file() {
  local src
  local dst
  local src_abs
  local current_src
  local current_src_abs
  local action
  local policy

  src=$1
  dst=$2

  if [ ! -f "$src" ] && [ ! -d "$src" ]; then
    return 1
  fi

  src_abs="$(cd "$(dirname "$src")" && pwd -P)/$(basename "$src")"

  if [ -L "$dst" ]; then
    current_src=$(readlink "$dst" 2>/dev/null || true)
    current_src_abs=$(absolute_link_target "$dst" "$current_src")
    if [ "$src_abs" = "$current_src_abs" ]; then
      success "already linked $dst"
      return 0
    fi
  fi

  # With no conflict there is nothing to decide, so the default policy never
  # reaches an existing target.
  policy=replace-with-backup

  if [ -e "$dst" ] || [ -L "$dst" ]; then
    if [ -n "$batch_mode" ]; then
      action=$batch_mode
    elif [ "$overwrite_all" = true ]; then
      action=overwrite
    elif [ "$backup_all" = true ]; then
      action=backup
    elif [ "$skip_all" = true ]; then
      action=skip
    else
      choose_link_action "$src" "$dst" || return 1
      action=$LINK_ACTION
    fi

    policy=$(link_action_policy "$action") || return 1
  fi

  # The linker reports what it did — linked, kept, backed up, replaced — so
  # saying "linked" here too would be a second voice, and a wrong one whenever
  # the policy was preserve-existing.
  "$LINK_CONFIG" --policy "$policy" --label "$dst" "$src_abs" "$dst" || return 1
}

catalog=$("$TOPIC_CATALOG" "$DOTFILES_ROOT") || exit 1

link_file "$DOTFILES_ROOT/.localrc" "$HOME/.localrc" || exit 1

while IFS=$'\t' read -r kind src; do
  [ "$kind" = link ] || continue
  link_file "$src" "$HOME/.$(basename "${src%.*}")" || exit 1
done <<<"$catalog"
