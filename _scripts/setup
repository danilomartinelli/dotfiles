#!/usr/bin/env bash
#
# Canonical dotfiles setup orchestration.

set -e
set -o pipefail

SETUP_PATH=${BASH_SOURCE[0]}
SCRIPT_DIR="$(CDPATH='' cd -P -- "$(dirname -- "$SETUP_PATH")" && pwd)"
ROOT_RESOLVER=$SCRIPT_DIR/../dotfiles-root.symlink
DOTFILES_ROOT=$("$ROOT_RESOLVER" "$SETUP_PATH")
export DOTFILES_ROOT
HOMEBREW_AVAILABILITY=$DOTFILES_ROOT/homebrew/_availability.sh
TOPIC_CATALOG=$DOTFILES_ROOT/_scripts/topic-catalog

# Topics whose installers create state that later installers consume, in the
# order they must run. Everything else follows in catalog order. Run order is
# orchestration and lives here: the catalog classifies topics by name, and
# nothing in a name says the Dock needs the Workspace directory to exist.
PREREQUISITE_TOPICS=(workspace)

BREW_BIN=''
CATALOG_SNAPSHOT=''
CATALOG_CAPTURED=false

info() {
  printf '  [ \033[00;34m..\033[0m ] %s\n' "$1"
}

prompt() {
  printf '  [ \033[0;33m??\033[0m ] %s\n' "$1"
}

success() {
  printf '  [ \033[00;32mOK\033[0m ] %s\n' "$1"
}

warn() {
  printf '  [\033[0;33mWARN\033[0m] %s\n' "$1" >&2
}

fail() {
  printf '  [\033[0;31mFAIL\033[0m] %s\n' "$1" >&2
  exit 1
}

# Whether the first argument appears among the remaining ones.
list_contains() {
  local needle=$1
  local candidate

  shift
  for candidate in "$@"; do
    if [ "$candidate" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

usage() {
  cat >&2 <<'EOF'
Usage: _scripts/setup bootstrap|update
       _scripts/setup checklist --open-apps

  bootstrap  Configure a new machine and install declared dependencies
  update     Refresh the checkout and installed dependencies
  checklist  Open the app setup checklist and launch listed apps only with
             the explicit --open-apps opt-in from an interactive terminal
EOF
}

run_critical() {
  local label
  label=$1
  shift

  info "$label"
  if "$@"; then
    success "$label"
  else
    fail "$label"
  fi
}

run_advisory() {
  local label
  label=$1
  shift

  info "$label"
  if "$@"; then
    success "$label"
  else
    warn "$label failed; continuing"
  fi
}

setup_local_environment() {
  if [ ! -f "$DOTFILES_ROOT/.localrc" ]; then
    cp "$DOTFILES_ROOT/.localrc.example" "$DOTFILES_ROOT/.localrc" || return 1
  fi

  chmod 600 "$DOTFILES_ROOT/.localrc" || return 1
}

escape_sed_replacement() {
  printf '%s\n' "$1" | sed 's/[\\&|]/\\&/g'
}

setup_gitconfig() {
  local git_credential
  local git_authorname
  local git_authoremail
  local git_authorname_escaped
  local git_authoremail_escaped

  if [ -f "$DOTFILES_ROOT/git/gitconfig.local.symlink" ]; then
    return 0
  fi

  git_credential='cache'
  if [ "$(uname -s)" = 'Darwin' ]; then
    git_credential='osxkeychain'
  fi

  prompt 'What is your GitHub author name?'
  read -r -e git_authorname || return 1
  prompt 'What is your GitHub author email?'
  read -r -e git_authoremail || return 1

  git_authorname_escaped=$(escape_sed_replacement "$git_authorname")
  git_authoremail_escaped=$(escape_sed_replacement "$git_authoremail")

  sed \
    -e "s|AUTHORNAME|$git_authorname_escaped|g" \
    -e "s|AUTHOREMAIL|$git_authoremail_escaped|g" \
    -e "s|GIT_CREDENTIAL_HELPER|$git_credential|g" \
    "$DOTFILES_ROOT/git/gitconfig.local.symlink.example" \
    >"$DOTFILES_ROOT/git/gitconfig.local.symlink"
}

setup_catalog() {
  if [ "$CATALOG_CAPTURED" != true ]; then
    CATALOG_SNAPSHOT=$("$TOPIC_CATALOG" "$DOTFILES_ROOT") || return 1
    CATALOG_CAPTURED=true
  fi
  printf '%s\n' "$CATALOG_SNAPSHOT"
}

install_dotfile_links() {
  "$DOTFILES_ROOT/_scripts/link-dotfiles" "$@"
}

apply_macos_configuration() {
  if [ "$(uname -s)" != 'Darwin' ]; then
    info 'macOS configuration skipped on this platform'
    return 0
  fi

  run_critical 'macOS defaults' "$DOTFILES_ROOT/_macos/set-defaults.sh"
  run_advisory 'hostname normalization' "$DOTFILES_ROOT/_macos/set-hostname.sh"
}

update_checkout() {
  if ! git -C "$DOTFILES_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    warn "$DOTFILES_ROOT is not a Git checkout"
    return 1
  fi

  git -C "$DOTFILES_ROOT" pull
}

ensure_homebrew() {
  local brew_prefix

  "$DOTFILES_ROOT/homebrew/install.sh" || return 1
  hash -r

  if ! BREW_BIN=$("$HOMEBREW_AVAILABILITY" binary); then
    warn 'Homebrew installer completed but brew is unavailable'
    return 1
  fi

  if ! brew_prefix=$("$HOMEBREW_AVAILABILITY" prefix); then
    return 1
  fi
  PATH="$brew_prefix/bin:$brew_prefix/sbin:$PATH"
  export PATH
}

install_declared_dependencies() {
  run_critical 'Brewfile dependencies' \
    "$DOTFILES_ROOT/homebrew/_bundle.sh" --brew "$BREW_BIN" --file "$DOTFILES_ROOT/Brewfile"
}

reconcile_homebrew_legacy_state() {
  "$DOTFILES_ROOT/homebrew/_maintenance.sh" --brew "$BREW_BIN"
}

install_topics() {
  local catalog
  local kind
  local installer
  local relative_installer
  local prerequisite
  local -a discovered=()
  local -a ordered=()

  catalog=$(setup_catalog) || return 1

  while IFS=$'\t' read -r kind installer; do
    [ "$kind" = installer ] || continue
    discovered+=("$installer")
  done <<<"$catalog"

  # A declared prerequisite that discovery never found is a typo or a deleted
  # topic. Stop: silently skipping it would restore the alphabetical order the
  # declaration exists to override, and only the dependent topic would notice.
  for prerequisite in "${PREREQUISITE_TOPICS[@]}"; do
    installer=$DOTFILES_ROOT/$prerequisite/install.sh
    if ! list_contains "$installer" "${discovered[@]}"; then
      fail "declared prerequisite topic has no installer: $prerequisite"
    fi
    ordered+=("$installer")
  done

  for installer in "${discovered[@]}"; do
    if ! list_contains "$installer" "${ordered[@]}"; then
      ordered+=("$installer")
    fi
  done

  for installer in "${ordered[@]}"; do
    relative_installer=${installer#"$DOTFILES_ROOT"/}

    info "topic installer: $relative_installer"
    if (cd "$DOTFILES_ROOT" && "$installer"); then
      success "topic installer: $relative_installer"
    else
      fail "topic installer: $relative_installer"
    fi
  done
}

run_dependency_pipeline() {
  local mode
  mode=$1

  run_critical 'Homebrew available' ensure_homebrew

  run_advisory 'Homebrew legacy cleanup' reconcile_homebrew_legacy_state

  if [ "$mode" = update ]; then
    run_advisory 'Homebrew update' "$BREW_BIN" update
    run_advisory 'Homebrew upgrade' "$BREW_BIN" upgrade
  fi

  install_declared_dependencies
  install_topics
}

install_checkout_root_link() {
  "$ROOT_RESOLVER" --install "$SETUP_PATH" >/dev/null
}

# Open an app in the background after the explicit interactive opt-in.
open_app() {
  local app_path=$1
  [ -d "$app_path" ] && open -ga "$app_path" 2>/dev/null || true
}

print_app_checklist() {
  printf '\n'
  printf '  \033[00;34m==>\033[0m \033[1mPost-bootstrap checklist\033[0m\n'
  printf '\n'
  printf '  Safety: this command does not access, create, delete, or modify Keychain items.\n'
  printf '  Log in manually in each app. A missing Slack Key prompt can indicate a\n'
  printf '  credential problem; stop and investigate it outside this setup flow.\n'
  printf '\n'
  printf '  The following steps require manual action in the UI:\n'
  printf '\n'
  printf '  \033[1mCredentials & keys\033[0m\n'
  printf '    ssh-key-create personal          # Ed25519 SSH key\n'
  printf '    ssh-key-create work              # work SSH key\n'
  printf '    sops-key-create personal         # age encryption key\n'
  printf '    gh auth login                    # GitHub CLI\n'
  printf '    cursor-agent login               # Cursor subscription\n'
  printf '    aws configure                    # AWS credentials\n'
  printf '\n'
  printf '  \033[1mApps this opt-in command opens — finish their setup wizards\033[0m\n'
  printf '    AeroSpace      → grant Accessibility permission; log out and back in\n'
  printf '    Bartender      → grant Screen Recording permission\n'
  printf '    Bitwarden      → log in to unlock the vault\n'
  printf '    Caffeine       → click the coffee cup in the menu bar to activate\n'
  printf '    ChatGPT        → sign in; set Option+Space global shortcut\n'
  printf '    CleanShot X    → grant Screen Recording + Accessibility permissions\n'
  printf '    Dia            → set as default browser: defaultbrowser dia\n'
  printf '    Google Drive   → sign in and choose folders to sync\n'
  printf '    KeyClu         → grant Accessibility permission\n'
  printf '    Paste          → grant Accessibility + Full Disk Access permissions\n'
  printf '    Raycast        → complete the onboarding; add script commands dir:\n'
  printf '      %s/raycast/scripts\n' "$DOTFILES_ROOT"
  printf '    Discord        → sign in to your account\n'
  printf '    Slack          → sign in to your workspace(s) manually\n'
  printf '    Spark          → sign in to your email accounts\n'
  printf '    Tailscale      → sign in and connect to your network\n'
  printf '\n'
  printf '  \033[1mApps requiring in-app setup\033[0m\n'
  printf '    Bitwarden      → System Settings → Passwords → Password Options → enable Bitwarden\n'
  printf '    Figma          → sign in to your account\n'
  printf '    Ghostty        → open once to verify font and shell\n'
  printf '    Obsidian       → open or create your vault (Google Drive for sync)\n'
  printf '    OrbStack       → open once and complete the onboarding wizard\n'
  printf '    Archiver       → open once to register as default for archive types\n'
  printf '    Postman        → sign in for workspace sync\n'
  printf '    Raycast        → install extensions: ChatGPT, Google Drive, Google Workspace\n'
  printf '    Skim           → open once to verify PDF associations\n'
  printf '    Spotify        → sign in to your account\n'
  printf '    WhatsApp       → scan QR code to pair with your phone\n'
  printf '\n'
  printf '  \033[1mShell\033[0m\n'
  printf '    source ~/.zshrc   # or open a new terminal tab\n'
  printf '\n'
}

open_app_checklist() {
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    fail 'app checklist opening requires an interactive terminal; no applications were opened'
  fi

  print_app_checklist

  # This is deliberately separate from bootstrap and update. The caller must
  # explicitly request checklist --open-apps from an interactive terminal.
  open_app '/Applications/Google Drive.app'
  open_app '/Applications/Bitwarden.app'
  open_app '/Applications/AeroSpace.app'
  open_app '/Applications/Bartender 6.app'
  open_app '/Applications/Bartender.app'
  open_app '/Applications/Caffeine.app'
  open_app '/Applications/ChatGPT.app'
  open_app '/Applications/CleanShot X.app'
  open_app '/Applications/Dia.app'
  open_app '/Applications/Discord.app'
  open_app '/Applications/Paste.app'
  open_app '/Applications/KeyClu.app'
  open_app '/Applications/Raycast.app'
  open_app '/Applications/Skim.app'
  open_app '/Applications/Slack.app'
  open_app '/Applications/Spark.app'
  open_app '/Applications/Tailscale.app'
}

run_bootstrap() {
  run_critical 'local environment' setup_local_environment
  run_critical 'Git identity' setup_gitconfig
  run_critical 'dotfile links' install_dotfile_links
  apply_macos_configuration
  run_dependency_pipeline bootstrap
}

run_update() {
  run_critical 'checkout root link' install_checkout_root_link
  run_advisory 'checkout refresh' update_checkout
  run_critical 'local environment' setup_local_environment
  run_critical 'dotfile links' install_dotfile_links --batch skip
  run_dependency_pipeline update
}

if [ "$#" -eq 2 ] && [ "$1" = checklist ] && [ "$2" = --open-apps ]; then
  open_app_checklist
  exit 0
fi

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

case "$1" in
  bootstrap) run_bootstrap ;;
  update) run_update ;;
  *)
    usage
    exit 2
    ;;
esac

printf '\n'
success "setup $1 complete"
