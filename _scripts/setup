#!/usr/bin/env bash
#
# Canonical dotfiles setup orchestration.

set -e
set -o pipefail

DOTFILES_ROOT=$(CDPATH='' cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export DOTFILES_ROOT
HOMEBREW_AVAILABILITY=$DOTFILES_ROOT/homebrew/_availability.sh
TOPIC_CATALOG=$DOTFILES_ROOT/_scripts/topic-catalog

# The topic whose installer makes Homebrew available. That installer runs
# before the Brewfile and every other topic installer runs after it, so the run
# plan takes it out of the topic installers. The classifier lists it like any
# other installer: when an installer runs is run order, which is setup's.
HOMEBREW_TOPIC=homebrew

# Topics whose installers create state that later installers consume, in the
# order they must run. Everything else follows in catalog order. Run order is
# orchestration and lives here: the catalog classifies topics by name, and
# nothing in a name says the Dock needs the Workspace directory to exist.
PREREQUISITE_TOPICS=(workspace)

BREW_BIN=''

# The run plan, from the one topic catalog this run reads. plan_run fills it
# before the first link, and every later phase reads it rather than
# classifying the checkout again.
LINK_SOURCES=()
HOMEBREW_INSTALLER=''
TOPIC_INSTALLERS=()

# shellcheck source=_scripts/output.sh
# shellcheck disable=SC1091
. "$DOTFILES_ROOT/_scripts/output.sh"

# Whether the first argument appears among the remaining ones.
list_contains() {
  local needle=$1
  local candidate

  shift
  for candidate in "$@"; do
    if [ "$candidate" = "$needle" ]; then
      return 0
    fi
  done
  return 1
}

usage() {
  cat >&2 <<'EOF'
Usage: _scripts/setup bootstrap|update
       _scripts/setup checklist --open-apps

  bootstrap  Configure a new machine and install declared dependencies
  update     Refresh the checkout and installed dependencies
  checklist  Open the app setup checklist and launch listed apps only with
             the explicit --open-apps opt-in from an interactive terminal
EOF
}

run_critical() {
  local label
  label=$1
  shift

  info "$label"
  if "$@"; then
    success "$label"
  else
    fail "$label"
  fi
}

run_advisory() {
  local label
  label=$1
  shift

  info "$label"
  if "$@"; then
    success "$label"
  else
    warn "$label failed; continuing"
  fi
}

setup_local_environment() {
  if [ ! -f "$DOTFILES_ROOT/.localrc" ]; then
    cp "$DOTFILES_ROOT/.localrc.example" "$DOTFILES_ROOT/.localrc" || return 1
  fi

  chmod 600 "$DOTFILES_ROOT/.localrc" || return 1
}

escape_sed_replacement() {
  printf '%s\n' "$1" | sed 's/[\\&|]/\\&/g'
}

setup_gitconfig() {
  local git_credential
  local git_authorname
  local git_authoremail
  local git_authorname_escaped
  local git_authoremail_escaped

  if [ -f "$DOTFILES_ROOT/git/gitconfig.local.symlink" ]; then
    return 0
  fi

  git_credential='cache'
  if [ "$(uname -s)" = 'Darwin' ]; then
    git_credential='osxkeychain'
  fi

  prompt 'What is your GitHub author name?'
  read -r -e git_authorname || return 1
  prompt 'What is your GitHub author email?'
  read -r -e git_authoremail || return 1

  git_authorname_escaped=$(escape_sed_replacement "$git_authorname")
  git_authoremail_escaped=$(escape_sed_replacement "$git_authoremail")

  sed \
    -e "s|AUTHORNAME|$git_authorname_escaped|g" \
    -e "s|AUTHOREMAIL|$git_authoremail_escaped|g" \
    -e "s|GIT_CREDENTIAL_HELPER|$git_credential|g" \
    "$DOTFILES_ROOT/git/gitconfig.local.symlink.example" \
    >"$DOTFILES_ROOT/git/gitconfig.local.symlink"
}

# Whether a path component is a name the classifier could emit: a visible
# name, which also rules out . and .., and never a path of its own.
is_visible_name() {
  case "$1" in
    '' | .* | _* | */*) return 1 ;;
  esac
}

# Whether a row has the shape the classifier emits for this checkout: an
# installer at <checkout>/<topic>/install.sh, a link at
# <checkout>/<name>.symlink or <checkout>/<topic>/<name>.symlink.
row_fits_layout() {
  local kind=$1
  local relative=${2#"$DOTFILES_ROOT"/}

  [ "$relative" != "$2" ] || return 1
  case "$kind:$relative" in
    installer:*/install.sh) is_visible_name "${relative%/install.sh}" ;;
    link:*/*.symlink)
      is_visible_name "${relative%%/*}" && is_visible_name "${relative#*/}"
      ;;
    link:*.symlink) is_visible_name "$relative" ;;
    *) return 1 ;;
  esac
}

# A declared catalog decides what this run links and executes, and an exported
# value survives into a real bootstrap, where nothing else would notice it. So
# every row it names must have a shape the classifier could have emitted for
# this checkout, and no row may appear twice. This is the same shape as the
# linker refusing an unattended removal outside the paths it owns: the seam
# stays open and its blast radius does not.
check_declared_catalog() {
  local kind path noun
  local -a seen=()

  while IFS=$'\t' read -r kind path; do
    case "$kind" in
      installer) noun='an installer' ;;
      link) noun='a link' ;;
      *) continue ;;
    esac
    if ! row_fits_layout "$kind" "$path"; then
      fail "declared topic catalog names $noun outside the checkout layout: $path"
    fi
    if list_contains "$kind"$'\t'"$path" "${seen[@]}"; then
      fail "declared topic catalog repeats a row: $path"
    fi
    seen+=("$kind"$'\t'"$path")
  done <<<"$1"
}

# Read the topic catalog this run orchestrates, once, and turn it into the run
# plan. DOTFILES_TOPIC_CATALOG supplies it from a file instead of running the
# classifier, which is the seam the Dock, the checklist, and the macOS defaults
# have each had for their own list.
#
# The rows are still read the way topic-catalog's stdout is read, not through
# catalog_each_row: what changes here is where the catalog comes from, not
# which shape it has.
#
# Bootstrap writes a link source in its Git identity phase, so this runs after
# it. It runs before the first link, so a plan that cannot run stops the run
# before any phase has consumed it.
plan_run() {
  local catalog kind path prerequisite installer
  local -a installers=()

  if [ -n "${DOTFILES_TOPIC_CATALOG:-}" ]; then
    [ -r "$DOTFILES_TOPIC_CATALOG" ] \
      || fail "topic catalog not readable: $DOTFILES_TOPIC_CATALOG"
    catalog=$(cat -- "$DOTFILES_TOPIC_CATALOG") || return 1
    check_declared_catalog "$catalog"
  else
    catalog=$("$TOPIC_CATALOG" "$DOTFILES_ROOT") || return 1
  fi

  while IFS=$'\t' read -r kind path; do
    case "$kind" in
      link) LINK_SOURCES+=("$path") ;;
      installer) installers+=("$path") ;;
    esac
  done <<<"$catalog"

  HOMEBREW_INSTALLER=$DOTFILES_ROOT/$HOMEBREW_TOPIC/install.sh
  if ! list_contains "$HOMEBREW_INSTALLER" "${installers[@]}"; then
    fail "Homebrew topic has no installer: $HOMEBREW_TOPIC"
  fi

  # A declared prerequisite the catalog does not list is a typo or a deleted
  # topic. Stop: silently skipping it would restore the alphabetical order the
  # declaration exists to override, and only the dependent topic would notice.
  for prerequisite in "${PREREQUISITE_TOPICS[@]}"; do
    installer=$DOTFILES_ROOT/$prerequisite/install.sh
    if ! list_contains "$installer" "${installers[@]}"; then
      fail "declared prerequisite topic has no installer: $prerequisite"
    fi
    TOPIC_INSTALLERS+=("$installer")
  done

  for installer in "${installers[@]}"; do
    if [ "$installer" != "$HOMEBREW_INSTALLER" ] \
      && ! list_contains "$installer" "${TOPIC_INSTALLERS[@]}"; then
      TOPIC_INSTALLERS+=("$installer")
    fi
  done
}

install_dotfile_links() {
  "$DOTFILES_ROOT/_scripts/link-dotfiles" "$@" -- "${LINK_SOURCES[@]}"
}

apply_macos_configuration() {
  if [ "$(uname -s)" != 'Darwin' ]; then
    info 'macOS configuration skipped on this platform'
    return 0
  fi

  run_critical 'macOS defaults' "$DOTFILES_ROOT/_macos/set-defaults.sh"
  run_advisory 'hostname normalization' "$DOTFILES_ROOT/_macos/set-hostname.sh"
}

update_checkout() {
  if ! git -C "$DOTFILES_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    warn "$DOTFILES_ROOT is not a Git checkout"
    return 1
  fi

  git -C "$DOTFILES_ROOT" pull
}

ensure_homebrew() {
  local brew_prefix

  "$HOMEBREW_INSTALLER" || return 1
  hash -r

  if ! BREW_BIN=$("$HOMEBREW_AVAILABILITY" binary); then
    warn 'Homebrew installer completed but brew is unavailable'
    return 1
  fi

  if ! brew_prefix=$("$HOMEBREW_AVAILABILITY" prefix); then
    return 1
  fi
  PATH="$brew_prefix/bin:$brew_prefix/sbin:$PATH"
  export PATH
}

install_declared_dependencies() {
  run_critical 'Brewfile dependencies' \
    "$DOTFILES_ROOT/homebrew/_bundle.sh" --brew "$BREW_BIN" --file "$DOTFILES_ROOT/Brewfile"
}

reconcile_homebrew_legacy_state() {
  "$DOTFILES_ROOT/homebrew/_maintenance.sh" --brew "$BREW_BIN"
}

install_topics() {
  local installer
  local relative_installer

  for installer in "${TOPIC_INSTALLERS[@]}"; do
    relative_installer=${installer#"$DOTFILES_ROOT"/}

    info "topic installer: $relative_installer"
    if (cd "$DOTFILES_ROOT" && "$installer"); then
      success "topic installer: $relative_installer"
    else
      fail "topic installer: $relative_installer"
    fi
  done
}

run_dependency_pipeline() {
  local mode
  mode=$1

  run_critical 'Homebrew available' ensure_homebrew

  run_advisory 'Homebrew legacy cleanup' reconcile_homebrew_legacy_state

  if [ "$mode" = update ]; then
    run_advisory 'Homebrew update' "$BREW_BIN" update
  fi

  install_declared_dependencies
  install_topics

  if [ "$mode" = update ]; then
    run_advisory 'Declared software upgrades' \
      env MISE_CONFIG_DIR="$DOTFILES_ROOT/mise" \
      MISE_GLOBAL_CONFIG_FILE="$DOTFILES_ROOT/mise/config.toml" \
      mise -C "$DOTFILES_ROOT" exec --locked python -- \
      "$DOTFILES_ROOT/_scripts/upgrade-software" --brew "$BREW_BIN"
  fi
}

# The post-bootstrap checklist is its own module: it owns the catalog, the
# sections, and the app opening, and setup only decides when to run it.
open_app_checklist() {
  "$DOTFILES_ROOT/_scripts/checklist" --open-apps
}

run_bootstrap() {
  run_critical 'local environment' setup_local_environment
  run_critical 'Git identity' setup_gitconfig
  run_critical 'topic catalog' plan_run
  run_critical 'dotfile links' install_dotfile_links
  apply_macos_configuration
  run_dependency_pipeline bootstrap
}

run_update() {
  run_advisory 'checkout refresh' update_checkout
  run_critical 'local environment' setup_local_environment
  run_critical 'topic catalog' plan_run
  run_critical 'dotfile links' install_dotfile_links --batch skip
  run_dependency_pipeline update
}

if [ "$#" -eq 2 ] && [ "$1" = checklist ] && [ "$2" = --open-apps ]; then
  open_app_checklist
  exit 0
fi

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

case "$1" in
  bootstrap) run_bootstrap ;;
  update) run_update ;;
  *)
    usage
    exit 2
    ;;
esac

printf '\n'
success "setup $1 complete"
