#!/usr/bin/env python3
"""Offer declared software upgrades after reconciling the committed environment."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
import urllib.request
from dataclasses import dataclass

# Importing the declaration reader must not leave a __pycache__ in the checkout.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import declared_software  # noqa: E402


@dataclass(frozen=True)
class Candidate:
    manager: str
    name: str
    current: str
    latest: str
    display_name: str = ""

    def label(self):
        major = ""
        old = re.match(r"v?(\d+)\.", self.current)
        new = re.match(r"v?(\d+)\.", self.latest)
        if old and new and old[1] != new[1]:
            major = " [major]"
        return f"{self.manager:12} {self.display_name or self.name}  {self.current} -> {self.latest}{major}"


def warn(message):
    print(f"Warning: {message}", file=sys.stderr)


def run(args, *, cwd, env, statuses=(0,), timeout=180):
    result = subprocess.run(
        args, cwd=cwd, env=env, text=True, capture_output=True, timeout=timeout
    )
    if result.returncode not in statuses:
        raise RuntimeError(f"{' '.join(args)} failed: {result.stderr.strip()}")
    if result.stderr.strip():
        warn(result.stderr.strip())
    return result.stdout


def read_toml(path):
    return tomllib.loads(path.read_text())


def execute(args, *, cwd, env):
    # Installs can need sudo and take minutes. Keep their progress and terminal
    # interaction visible instead of capturing it like a discovery query.
    result = subprocess.run(args, cwd=cwd, env=env)
    if result.returncode:
        raise RuntimeError(
            f"{' '.join(args)} failed; earlier upgrades may already have completed"
        )


def write_source(path, content):
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
        os.chmod(temporary, path.stat().st_mode & 0o777)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def brewfile_declarations(root, kind):
    brewfile = declared_software.read_brewfile(root / "Brewfile")
    return [d for d in brewfile.declarations if d.kind == kind]


# Each manager owns what its package manager knows: which declarations it
# reads, how it finds upgrade candidates, what its vulnerability report covers,
# and how it applies a selection. discover() may run again before apply() to
# detect a changed plan; audit() prints its findings and returns what it does
# not cover.


class Homebrew:
    label = "Homebrew"

    def __init__(self, root, brew, env):
        self.root, self.brew, self.env = root, brew, env

    def discover(self):
        candidates = []
        for kind, key in (("formula", "formulae"), ("cask", "casks")):
            names = [d.name for d in brewfile_declarations(self.root, kind)]
            if not names:
                continue
            args = [self.brew, "outdated", "--json=v2", f"--{kind}"]
            if kind == "cask":
                args.append("--greedy")
            # Named outdated queries return 1 when updates exist. Malformed or
            # missing JSON remains an error rather than an empty candidate set.
            data = json.loads(
                run(args + names, cwd=self.root, env=self.env, statuses=(0, 1))
            )
            for item in data[key]:
                matches = [
                    name
                    for name in names
                    if name == item["name"] or name.split("/")[-1] == item["name"]
                ]
                if len(matches) != 1:
                    raise ValueError(
                        f"undeclared or ambiguous Homebrew candidate: {item['name']}"
                    )
                if item.get("pinned"):
                    print(f"Keeping {item['name']}: held with brew pin")
                    continue
                candidates.append(
                    Candidate(
                        f"brew-{kind}",
                        matches[0],
                        ", ".join(item["installed_versions"]),
                        item["current_version"],
                    )
                )
        return candidates

    def audit(self, candidates):
        try:
            output = run(
                [
                    self.brew,
                    "vulns",
                    f"--brewfile={self.root / 'Brewfile'}",
                    "--deps",
                    "--list-skipped",
                    "--json",
                ],
                cwd=self.root,
                env=self.env,
                statuses=(0, 1),
            )
            report = json.loads(output)
            for finding in report["findings"]:
                for vuln in finding["vulnerabilities"]:
                    print(
                        f"  Brew {finding['formula']} {finding['version']}: {vuln['id']}"
                    )
            print(
                f"  Brew: {len(report['findings'])} formula findings; "
                f"skipped: {json.dumps(report['skipped_formulae'])}"
            )
        except (
            OSError,
            ValueError,
            KeyError,
            RuntimeError,
            subprocess.TimeoutExpired,
        ) as error:
            warn(f"Homebrew vulnerability coverage unavailable: {error}")
        return ["casks"]

    def apply(self, selected):
        for candidate in selected:
            kind = candidate.manager.removeprefix("brew-")
            command = [self.brew, "upgrade", f"--{kind}"]
            if kind == "cask":
                command.append("--greedy")
            execute(command + [candidate.name], cwd=self.root, env=self.env)


class AppStore:
    label = "App Store"

    def __init__(self, root, env):
        self.root, self.env = root, env

    def discover(self):
        # An App Store app's identity is its App ID, which is what mas accepts.
        ids = {d.identifier for d in brewfile_declarations(self.root, "mas")}
        if not ids:
            return []
        output = run(
            ["mas", "outdated", "--inaccurate", *sorted(ids)],
            cwd=self.root,
            env={**self.env, "MAS_NO_AUTO_INDEX": "1"},
        )
        candidates = []
        for line in output.splitlines():
            match = re.fullmatch(
                r"(\d+)\s+(.+?)\s+\((.+?)\s+->\s+(.+?)\)", line.strip()
            )
            if match and match[1] in ids:
                candidates.append(
                    Candidate(
                        "mas", match[1], match[3], match[4], f"{match[2]} ({match[1]})"
                    )
                )
        return candidates

    def audit(self, candidates):
        return ["App Store apps"]

    def apply(self, selected):
        for candidate in selected:
            mas = shutil.which("mas")
            if mas is None:
                raise RuntimeError("mas became unavailable; restore it and retry")
            command = (["sudo"] if os.geteuid() != 0 else []) + [
                mas,
                "upgrade",
                "--inaccurate",
                candidate.name,
            ]
            execute(command, cwd=self.root, env=self.env)


class Mise:
    label = "Mise"

    def __init__(self, root, env):
        self.root, self.env = root, env

    def command(self, operation, *args, stage=None):
        command = [str(self.root / "_scripts/mise-policy"), str(self.root)]
        if stage is not None:
            command += ["--declarations", str(stage / "mise")]
        return [*command, operation, *args]

    def discover(self):
        declarations = declared_software.read_mise_config(
            self.root / "mise/config.toml"
        )
        candidates = []
        # Pins may advance to a new major; channels only move within themselves.
        for bump in (False, True):
            names = [d.name for d in declarations if (d.selection == "pin") == bump]
            if not names:
                continue
            args = ["outdated", "--json"] + (["--bump"] if bump else []) + names
            data = json.loads(run(self.command("run", *args), cwd=self.root, env=self.env))
            for name, item in data.items():
                if name not in names:
                    # Mise can report a short backend name (e.g. shellcheck).
                    matches = [
                        n for n in names if n.split(":")[-1].split("/")[-1] == name
                    ]
                    if len(matches) != 1:
                        raise ValueError(f"cannot identify Mise candidate {name}")
                    name = matches[0]
                if item.get("current") and item.get("latest"):
                    candidates.append(
                        Candidate("mise", name, item["current"], item["latest"])
                    )
        return candidates

    def audit(self, candidates):
        # OSV accepts package ecosystem identities. The legacy Mise lock does not
        # contain an auditable dependency graph; do not claim a transitive scan.
        queries, labels, uncovered = [], [], []
        try:
            tools = [
                d.name
                for d in declared_software.read_mise_config(
                    self.root / "mise/config.toml"
                )
            ]
            locked = read_toml(self.root / "mise/mise.lock")["tools"]
        except (OSError, ValueError, KeyError) as error:
            warn(f"Mise vulnerability coverage unavailable: {error}")
            tools, locked = [], {}
        for name in tools:
            ecosystem = (
                "npm"
                if name.startswith("npm:")
                else "PyPI"
                if name.startswith("pipx:")
                else None
            )
            if ecosystem is None:
                uncovered.append(name)
                continue
            entries = locked.get(name, [])
            versions = {entry["version"] for entry in entries}
            versions.update(c.latest for c in candidates if c.name == name)
            for version in sorted(versions):
                queries.append(
                    {
                        "package": {
                            "ecosystem": ecosystem,
                            "name": name.split(":", 1)[1],
                        },
                        "version": version,
                    }
                )
                labels.append(f"{name} {version}")
        if queries:
            try:
                request = urllib.request.Request(
                    "https://api.osv.dev/v1/querybatch",
                    data=json.dumps({"queries": queries}).encode(),
                    headers={"Content-Type": "application/json"},
                )
                with urllib.request.urlopen(request, timeout=30) as response:
                    results = json.load(response)["results"]
                if len(results) != len(queries):
                    raise ValueError("incomplete OSV response")
                count = 0
                for label, result in zip(labels, results):
                    findings = result.get("vulns", [])
                    count += len(findings)
                    if findings:
                        print(f"  {label}: {', '.join(v['id'] for v in findings)}")
                    if result.get("next_page_token"):
                        warn(
                            f"{label}: additional findings exist; report is incomplete"
                        )
                print(
                    f"  OSV: {count} known findings across {len(queries)} direct npm/PyPI version queries."
                )
            except (OSError, ValueError, KeyError) as error:
                warn(f"Mise vulnerability coverage unavailable: {error}")
        # Tools outside OSV's ecosystems form one gap, so the report's closing
        # "and" introduces their list.
        return [
            "transitive Mise dependencies",
            "formatter extras",
            ", ".join(uncovered),
        ]

    def apply(self, selected):
        paths = [Path("mise/config.toml"), Path("mise/mise.lock"), Path("README.md")]
        original = {path: (self.root / path).read_bytes() for path in paths}
        config_text = original[paths[0]].decode()
        declarations = {
            d.name: d
            for d in declared_software.parse_mise_config(
                config_text, str(self.root / paths[0])
            )
        }
        old_lock = tomllib.loads(original[paths[1]].decode())["tools"]
        chosen = {c.name: c.latest for c in selected}
        with tempfile.TemporaryDirectory(prefix="dotfiles-upgrade-") as temporary:
            stage = Path(temporary)
            (stage / "mise").mkdir()
            for path, content in original.items():
                (stage / path).write_bytes(content)
            shutil.copyfile(self.root / "Brewfile", stage / "Brewfile")
            stage_config = stage / paths[0]
            stage_config.write_text(
                declared_software.rewrite_versions(config_text, chosen)
            )
            run(self.command("lock", *chosen, stage=stage), cwd=stage, env=self.env)
            # Keep channels such as lts and temurin-25 while advancing their lock.
            persistent = {
                name: version
                if declarations[name].selection == "pin"
                else declarations[name].version
                for name, version in chosen.items()
            }
            stage_config.write_text(
                declared_software.rewrite_versions(config_text, persistent)
            )
            run(self.command("lock", *chosen, stage=stage), cwd=stage, env=self.env)
            new_lock = read_toml(stage / paths[1])["tools"]
            for name in old_lock.keys() | new_lock.keys():
                if name in chosen:
                    # Mise owns backend defaults and platform-specific variants
                    # (Ruby, for example). Ask its resolver which version is active.
                    active = json.loads(
                        run(
                            self.command("run", "ls", "--json", "--current", name, stage=stage),
                            cwd=stage,
                            env=self.env,
                        )
                    )
                    valid = [entry["version"] for entry in active] == [chosen[name]]
                else:
                    valid = new_lock.get(name) == old_lock.get(name)
                if not valid:
                    raise ValueError(
                        f"lock changed outside the selection or missed its target: {name}"
                    )
            run(
                [str(self.root / "_scripts/render-software-catalog"), str(stage)],
                cwd=stage,
                env=self.env,
            )
            execute(self.command("run", "install", *chosen, stage=stage), cwd=stage, env=self.env)
            if any(
                (self.root / path).read_bytes() != content
                for path, content in original.items()
            ):
                raise RuntimeError(
                    "source changed during upgrade; installed tools were not activated; retry"
                )
            # Preserve the repository-owned files and global symlinks. Restore the
            # source snapshot if publishing any file fails; installed copies remain.
            written = []
            try:
                for path in paths:
                    write_source(self.root / path, (stage / path).read_bytes())
                    written.append(path)
            except OSError:
                for path in written:
                    write_source(self.root / path, original[path])
                raise
        print(
            "Mise declarations, lock, and README updated; review the Git diff and commit when ready."
        )
        # The normal installer also repairs agent binaries after their postinstall.
        execute(
            [str(self.root / "mise/install.sh")],
            cwd=self.root,
            env=self.env,
        )


def audit(managers, found):
    print("\nVulnerability report (advisory; does not block upgrades)")
    gaps = [
        gap for manager in managers for gap in manager.audit(found.get(manager, []))
    ]
    print("  Not covered: " + ", ".join(gaps[:-1] + ["and " + gaps[-1]]))


def choose(candidates, env):
    rows = [f"{i}\t{c.label()}" for i, c in enumerate(candidates)]
    picker_env = {**env, "FZF_DEFAULT_OPTS": "", "FZF_DEFAULT_OPTS_FILE": ""}
    result = subprocess.run(
        [
            "fzf",
            "--multi",
            "--delimiter=\t",
            "--with-nth=2..",
            "--no-sort",
            "--wrap",
            "--bind=space:toggle,ctrl-a:select-all,ctrl-d:deselect-all",
            "--header=Upgrades | Tab/Space: select | Ctrl-A: all | Enter: review | Esc: skip",
            "--prompt=Upgrade> ",
        ],
        input="\n".join(rows),
        text=True,
        capture_output=True,
        env=picker_env,
    )
    if result.returncode in (1, 130):
        return []
    if result.returncode != 0:
        raise RuntimeError(f"upgrade picker failed: {result.stderr.strip()}")
    selected = []
    for row in result.stdout.splitlines():
        if row not in rows:
            raise ValueError("picker returned an unknown candidate")
        candidate = candidates[int(row.split("\t", 1)[0])]
        if candidate not in selected:
            selected.append(candidate)
    if not selected:
        return []
    print("\nSelected upgrades (required dependencies may also change):")
    for candidate in selected:
        print("  " + candidate.label())
    return (
        selected
        if input("Apply selected upgrades? [y/N] ").strip().lower() in ("y", "yes")
        else []
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--brew", required=True)
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    # Every subprocess inherits these, not only brew: a manager that applies
    # earlier and reaches brew indirectly must not refresh Homebrew's catalog
    # between the requery and the confirmed Homebrew upgrades.
    env = {
        **os.environ,
        "HOMEBREW_NO_AUTO_UPDATE": "1",
        "HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK": "1",
    }
    homebrew = Homebrew(root, args.brew, env)
    app_store = AppStore(root, env)
    mise = Mise(root, env)
    managers = (homebrew, app_store, mise)
    found = {}
    for manager in managers:
        try:
            found[manager] = manager.discover()
        except (
            OSError,
            ValueError,
            KeyError,
            RuntimeError,
            subprocess.TimeoutExpired,
        ) as error:
            warn(f"{manager.label} update discovery unavailable: {error}")
    candidates = [candidate for manager in found for candidate in found[manager]]
    audit(managers, found)
    if not candidates:
        print("No upgrade candidates found in the successfully queried declarations.")
        return 0
    print("\nAvailable upgrades:")
    for candidate in candidates:
        print("  " + candidate.label())
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("Non-interactive run: upgrades were not selected or applied.")
        return 0
    if not shutil.which("fzf"):
        warn(
            "fzf unavailable; no upgrades applied. Restore the declared fzf package and retry."
        )
        return 0
    selected = choose(candidates, env)
    if not selected:
        print("No upgrades selected.")
        return 0
    plan = {
        manager: [c for c in selected if c in found.get(manager, [])]
        for manager in managers
    }
    # Requery the selected managers before any install. Homebrew and App Store
    # install the current catalog version, so never knowingly apply a changed plan.
    current = [c for manager in managers if plan[manager] for c in manager.discover()]
    if any(candidate not in current for candidate in selected):
        raise RuntimeError(
            "upgrade candidates changed while selecting; rerun dot to review them"
        )
    # Mise prepares and validates its source changes before it installs, so a
    # failed preparation stops the run before any other manager upgrades.
    for manager in (mise, homebrew, app_store):
        if plan[manager]:
            manager.apply(plan[manager])
    print(
        "Selected upgrades completed. Package-manager operations are not an atomic rollback."
    )
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (
        OSError,
        ValueError,
        KeyError,
        RuntimeError,
        subprocess.TimeoutExpired,
    ) as error:
        warn(str(error))
        sys.exit(1)
    except (KeyboardInterrupt, EOFError):
        print("\nUpgrade interaction stopped.")
        sys.exit(1)
