#!/bin/sh

set -eu

# shellcheck source=_scripts/key-provisioning.sh
# shellcheck disable=SC1091
# Resolved with builtins only: a key command must still be able to report a
# missing generator when it is run with an empty PATH, which is how the
# provisioning suites prove that guard. dirname is /usr/bin/dirname.
. "$(CDPATH='' cd -P -- "${0%/*}/../_scripts" && pwd)/key-provisioning.sh"

program_name=sops-key-create

usage() {
  cat <<'EOF'
Usage: sops-key-create <default|personal|work>

Create one age identity for SOPS. Keys are written under
~/.config/sops/age/ and never overwrite existing material.

Examples:
  sops-key-create default
  sops-key-create personal
  sops-key-create work
EOF
}

key_handle_help "$program_name" usage "$@"

[ "$#" -eq 1 ] || key_usage_error "$program_name" usage 'a key role is required'

role=$1
case "$role" in
  default)
    key_name=keys.txt
    recipient_name=recipient.txt
    ;;
  personal)
    key_name=keys_personal.txt
    recipient_name=recipient_personal.txt
    ;;
  work)
    key_name=keys_work.txt
    recipient_name=recipient_work.txt
    ;;
  *) key_usage_error "$program_name" usage "unknown key role: $role" ;;
esac

key_require_generator "$program_name" age-keygen 'brew install age'

# Not XDG-derived, deliberately: this path must agree with the one sops/env.zsh
# names in SOPS_AGE_KEY_FILE, or sops cannot find the identity created here.
# See docs/adr/0003-tool-config-directories-are-not-xdg-derived.md.
age_dir=$HOME/.config/sops/age
key_path=$age_dir/$key_name
recipient_path=$age_dir/$recipient_name

key_refuse_existing "$program_name" 'key material' "$key_path"
key_refuse_existing "$program_name" 'recipient file' "$recipient_path"

key_prepare_dir "$age_dir"

# age-keygen prints the public key to stderr, so this captures both streams and
# reports them itself when the generator fails.
keygen_output=

generate_age_key() {
  keygen_status=0
  keygen_output=$(age-keygen -o "$key_path" 2>&1) || keygen_status=$?
  if [ "$keygen_status" -ne 0 ]; then
    printf '%s\n' "$keygen_output" >&2
    return "$keygen_status"
  fi
}

echo "› creating $role age key for SOPS"
key_run_generator "$program_name" age-keygen "$key_path" generate_age_key

chmod 600 "$key_path"

# Prefer the public key line from age-keygen stderr ("Public key: age1...").
public_key=$(printf '%s\n' "$keygen_output" | sed -n 's/^Public key: //p' | head -n 1)
if [ -z "$public_key" ]; then
  public_key=$(sed -n 's/^# public key: //p' "$key_path" | head -n 1)
fi

if [ -z "$public_key" ]; then
  echo "$program_name: created $key_path but could not extract the public recipient" >&2
  exit 1
fi

printf '%s\n' "$public_key" >"$recipient_path"
chmod 644 "$recipient_path"

echo "✓ created $key_path"
echo "  Recipient: $public_key"
echo "  Public key file: $recipient_path"
if [ "$role" = default ]; then
  echo "  SOPS will use this identity via:"
  echo "    export SOPS_AGE_KEY_FILE=\"$key_path\""
  echo "  Encrypt with:"
  echo "    sops --age \"\$(cat \"$recipient_path\")\" -e -i secrets.yaml"
else
  echo "  Point SOPS at this identity when needed:"
  echo "    export SOPS_AGE_KEY_FILE=\"$key_path\""
fi
