#!/bin/sh

set -eu

# shellcheck source=_scripts/key-provisioning.sh
# shellcheck disable=SC1091
# Resolved with builtins only: a key command must still be able to report a
# missing generator when it is run with an empty PATH, which is how the
# provisioning suites prove that guard. dirname is /usr/bin/dirname.
. "$(CDPATH='' cd -P -- "${0%/*}/../_scripts" && pwd)/key-provisioning.sh"

program_name=ssh-key-create

usage() {
  cat <<'EOF'
Usage: ssh-key-create <default|personal|work> [--rsa]

Create one SSH key pair. Ed25519 is used unless --rsa is provided.

Examples:
  ssh-key-create default
  ssh-key-create personal
  ssh-key-create work --rsa
EOF
}

key_handle_help "$program_name" usage "$@"

[ "$#" -ge 1 ] || key_usage_error "$program_name" usage 'a key role is required'
[ "$#" -le 2 ] || key_usage_error "$program_name" usage 'too many arguments'

role=$1
case "$role" in
  default)
    role_suffix=
    test_host=github.com
    ;;
  personal)
    role_suffix=_personal
    test_host=github-personal
    ;;
  work)
    role_suffix=_work
    test_host=github-work
    ;;
  *) key_usage_error "$program_name" usage "unknown key role: $role" ;;
esac

key_type=ed25519
if [ "$#" -eq 2 ]; then
  [ "$2" = --rsa ] || key_usage_error "$program_name" usage "unknown option: $2"
  key_type=rsa
fi

key_require_generator "$program_name" ssh-keygen

SSH_DIR=$HOME/.ssh
if [ "$key_type" = rsa ]; then
  key_name=id_rsa$role_suffix
else
  key_name=id_ed25519$role_suffix
fi

key_path=$SSH_DIR/$key_name
public_key_path=$key_path.pub

key_refuse_existing "$program_name" 'key material' "$key_path" "$public_key_path"

git_email=
if command -v git >/dev/null 2>&1; then
  git_email=$(git config --global user.email 2>/dev/null || true)
fi

if [ -z "$git_email" ]; then
  key_user=${USER:-}
  if [ -z "$key_user" ]; then
    key_user=$(id -un)
  fi
  git_email=$key_user@$(hostname)
fi

case "$role" in
  personal) key_comment=$git_email' (personal)' ;;
  work) key_comment=$git_email' (work)' ;;
  *) key_comment=$git_email ;;
esac

key_prepare_dir "$SSH_DIR"

generate_ssh_key() {
  if [ "$key_type" = rsa ]; then
    ssh-keygen -t rsa -b 4096 -f "$key_path" -C "$key_comment"
  else
    ssh-keygen -t ed25519 -f "$key_path" -C "$key_comment"
  fi
}

echo "› creating $role SSH key ($key_type)"
key_run_generator "$program_name" ssh-keygen "$key_path" generate_ssh_key

chmod 600 "$key_path"
chmod 644 "$public_key_path"

echo "✓ created $key_path"
echo "  Public key: $public_key_path"
echo "  Add the public key to the remote service, then test with:"
echo "    ssh -T $test_host"
